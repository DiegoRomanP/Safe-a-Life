{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "senior",
  "share": "disabled",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "permission": {
    "*": "allow"
  },
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "penpot": {
      "type": "remote",
      "enabled": true,
      "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_USER_TOKEN}"
    }
  }
}
