{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "senior",
  "share": "disabled",
  "snapshot": true,
  "permission": {
    "task": "deny"
  },
  "agent": {
    "build": {
      "permission": {
        "task": "deny"
      }
    },
    "plan": {
      "permission": {
        "task": "deny"
      }
    },
    "general": {
      "permission": {
        "task": "deny"
      }
    },
    "explore": {
      "permission": {
        "task": "deny"
      }
    },
    "maestro-protegido": {
      "permission": {
        "task": "deny"
      }
    },
    "maestro-libre": {
      "permission": {
        "task": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "penpot": {
      "type": "remote",
      "enabled": true,
      "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_USER_TOKEN}"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT_7}"
      },
      "enabled": true
    }
  }
}
