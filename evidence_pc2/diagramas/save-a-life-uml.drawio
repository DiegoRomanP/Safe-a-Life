or=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="draftGatewayFor()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="RPC con el JWT&lt;br&gt;del usuario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="«composition root» &lt;b&gt;composition.ts&lt;/b&gt;&lt;br&gt;crea el adaptador y lo pasa al caso de uso" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d9f2f0;strokeColor=#2b7a78;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="330" height="60" as="geometry"/></mxCell><mxCell id="c26" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="730"/></Array></mxGeometry></mxCell><mxCell id="c27" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="730"/><mxPoint x="1210" y="430"/><mxPoint x="1277" y="430"/></Array></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Regla de dependencias&lt;/b&gt;&lt;br&gt;domain/ no importa nada externo; needs-service.ts importa tipos de domain/, sus puertos y shared/crypto/fingerprint. application/ importa domain/, sus puertos, dto/ y utilidades puras de shared/ (crypto, validation). Solo infrastructure/ conoce el SDK de Supabase." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="400" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p04" name="04 Contract-first"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Contract-first — diagrama de actividad&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1690" height="32" as="geometry"/></mxCell><mxCell id="c2" value="docs/openapi.json (OpenAPI 3.1) es la única fuente del contrato. Todo lo demás se genera o se valida contra él; los generados nunca se editan a mano." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1690" height="36" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Editar docs/openapi.json&lt;/b&gt;&lt;br&gt;(x-ratification por operación)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" vertex="1" parent="1"><mxGeometry x="110" y="135" width="210" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;npm run openapi:lint&lt;/b&gt;&lt;br&gt;Redocly" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;arcSize=30;" vertex="1" parent="1"><mxGeometry x="370" y="135" width="190" height="70" as="geometry"/></mxCell><mxCell id="c6" value="¿válido?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="100" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;npm run openapi:types&lt;/b&gt;&lt;br&gt;generate-api-contract.mjs --write" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d9f2f0;strokeColor=#2b7a78;arcSize=30;" vertex="1" parent="1"><mxGeometry x="770" y="135" width="240" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c6" target="c7"><mxGeom