p;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="680" width="760" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p20" name="20 Clases: modelo de dominio"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Clases: modelo de dominio (tipos y reglas puras)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Dominio del prototipo: la compatibilidad solo preselecciona donantes para RBC; no certifica elegibilidad ni seguridad clínica. No se modelan pacientes ni historial de donaciones." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="32" as="geometry"/></mxCell><mxCell id="h1" value="Necesidad" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="390" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Donante y ubicación" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="115" width="390" height="20" as="geometry"/></mxCell><mxCell id="h3" value="Invitación" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="970" y="115" width="390" height="20" as="geometry"/></mxCell><mxCell id="h4" value="Preselección y ranking" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1430" y="115" width="430" height="20" as="geometry"/></mxCell><mxCell id="NeedDraft" value="«type»&lt;br&gt;&lt;b&gt;NeedDraft&lt;/b&gt; (need-draft.ts:35)&lt;hr&gt;owner: NeedDraftOwner { actorId, hospitalId }&lt;br&gt;projection: NeedDraftProjection { needId, component: 'RBC', requiredBloodType: NeedBloodType, targetConfirmations, confirmedIntentCount: 0, siteId, radiusKm, urgency, status: 'borrador', expiresAt }&lt;hr&gt;NeedBloodType (:2): O/A/B/AB × NEG/POS&lt;br&gt;NeedUrgency: Normal | Urgente | Critica." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="390" height="300" as="geometry"/></mxCell><mxCell id="NeedState" value="«funciones puras»&lt;br&gt;&lt;b&gt;NeedStatus / evaluateManualTransition&lt;/b&gt; (need-state.ts:2, 52)&lt;hr&gt;Estados: borrador, activa, meta_alcanzada, cerrada, cancelada, vencida.&lt;br&gt;Manual: borrador → activa/cancelada; activa o meta_alcanzada → cerrada/cancelada.&lt;hr&gt;cerrada, cancelada y vencida son terminales; meta_alcanzada y vencida se proyectan por el sistema." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="390" height="230" as="geometry"/></mxCell><mxCell id="DonorProfile" value="«type / funciones puras»&lt;br&gt;&lt;b&gt;DonorProfileDraft&lt;/b&gt; (donor-profile.ts:7)&lt;hr&gt;name · declaredBloodType · isAvailable · approximateLocation&lt;br&gt;+ canActivate(profile)&lt;hr&gt;Estados de perfil: pendiente_verificacion → incompleto → activo. Edición directa del donante: solo disponibilidad y ubicación; nombre y grupo requieren corrección." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="390" height="250" as="geometry"/></mxCell><mxCell id="Location" value="«type / funciones puras»&lt;br&gt;&lt;b&gt;ApproximateLocation&lt;/b&gt; (location.ts:3)&lt;hr&gt;latitude · longitude&lt;br&gt;+ validateApproximateLocation(location): LocationVerdict (:37)&lt;hr&gt;Rango válido, máximo 3 decimales (≈110 m) y punto dentro o sobre el borde del polígono versionado de Lima. Coordenadas exactas no se exponen en UI/API/logs." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="390" height="250" as="geometry"/></mxCell><mxCell id="Invitation" value="«ejes independientes»&lt;br&gt;&lt;b&gt;Validity · Delivery · Response&lt;/b&gt; (invitation-state.ts:2–4)&lt;hr&gt;Validez: activa → invalidada/vencida (terminales).&lt;br&gt;Entrega: pendiente → enviada/fallida; enviada → entregada/fallida; fallida → pendiente solo por reintento manual auditado.&lt;br&gt;Respuesta: sin_respuesta → confirmada/rechazada; confirmada ↔ rechazada con sesión y necesidad no terminal (lo exige la RPC).&lt;hr&gt;canTransitionValidity / Delivery / Response (:16–18).&lt;br&gt;No colapsar los tres estados en un booleano." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="150" width="390" height="360" as="geometry"/></mxCell><mxCell id="Candidate" value="«type / funciones puras»&lt;br&gt;&lt;b&gt;Candidate&lt;/b&gt; (ranking.ts:1)&lt;hr&gt;donorId · isExact · distanceM&lt;br&gt;+ compareCandidates / rankCandidates (:4, :10)&lt;hr&gt;Orden determinista: coincidencia exacta primero, distancia ascendente, donorId ascendente." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="150" width="430" height="220" as="geometry"/></mxCell><mxCell id="Compatibility" value="«funciones puras»&lt;br&gt;&lt;b&gt;MATRIZ_RBC_ACADEMICA_V1&lt;/b&gt; (compatibility.ts:6)&lt;hr&gt;+ isCompatible(donor, recipient): boolean (:17)&lt;br&gt;+ isExactMatch(donor, recipient): boolean (:21)&lt;hr&gt;Usa NeedBloodType (importado de need-records/domain/need-draft.ts). Matriz académica de glóbulos rojos; no reutilizar para otros componentes ni presentarla como validación clínica." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="400" width="430" height="250" as="geometry"/></mxCell><mxCell id="Distance" value="«funciones puras»&lt;br&gt;&lt;b&gt;haversineMeters / isWithinRadius&lt;/b&gt; (haversine.ts:7, 15)&lt;hr&gt;EARTH_RADIUS_M = 6,371,008.8&lt;br&gt;Distancia en metros; el borde del radio se incluye (≤ radiusKm × 1000).&lt;hr&gt;batchSize(targetConfirmations) = min(50, max(5, 2 × meta)) (batch-size.ts:2)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="680" width="430" height="210" as="geometry"/></mxCell><mxCell id="relations" value="Relaciones verificadas: NeedDraft contiene NeedDraftOwner y NeedDraftProjection; su estado inicial es 'borrador', y need-state.ts evalúa las transiciones. DonorProfileDraft referencia ApproximateLocation. La matriz de compatibilidad importa NeedBloodType desde need-records. El ranking ordena Candidate; distancia y compatibilidad son funciones puras, no clases con estado." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="965" width="1810" height="80" as="geometry"/></mxCell><mxCell id="e1" value="estado inicial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="NeedDraft" target="NeedState"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="approximateLocation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DonorProfile" target="Location"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p21" name="21 Clases: need-records"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Clases: need-records (creación de borradores, lectura y transiciones de necesidades)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="st" value="Flecha punteada con punta abierta: dependencia («usa»). Punteada con triángulo hueco: realización («implementa»). Línea continua: asociación. Entre paréntesis, el archivo:línea de cada declaración (bajo backend/src/modules/need-records/)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="36" as="geometry"/></mxCell><mxCell id="h1" value="Adaptador de entrada (HTTP)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Aplicación (casos de uso)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h3" value="Puertos (interfaces)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h4" value="Adaptador de salida (RPC)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h5" value="shared/ y dominio" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1580" y="98" width="300" height="20" as="geometry"/></mxCell><mxCell id="R" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerNeedsRoutes(app, deps)&lt;/b&gt; (:46)&lt;hr&gt;- needs: NeedsService&lt;br&gt;- createDraft: (accessToken) → CreateNeedDraft&lt;br&gt;- secrets: HttpSecrets&lt;hr&gt;POST /api/v1/hospitals/me/needs&lt;br&gt;GET /api/v1/hospitals/me/needs[/:needId]&lt;br&gt;PATCH /api/v1/hospitals/me/needs/:needId" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="330" height="200" as="geometry"/></mxCell><mxCell id="CDS" value="«factory»&lt;br&gt;&lt;b&gt;createNeedDraftService(gateway)&lt;/b&gt; (:93)&lt;hr&gt;- gateway: AtomicNeedDraftGateway&lt;hr&gt;+ (body, context, idempotency): Promise&amp;lt;CreateNeedDraftResult&amp;gt;&lt;br&gt;privado: fingerprintNeedDraftInput (:21)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="330" height="150" as="geometry"/></mxCell><mxCell id="NS" value="«factory»&lt;br&gt;&lt;b&gt;createNeedsService(repository)&lt;/b&gt; (:10)&lt;hr&gt;- repository: NeedsRepository&lt;hr&gt;+ list(token, query): Page&amp;lt;NeedView&amp;gt;&lt;br&gt;+ get(token, needId): NeedView&lt;br&gt;+ transition(token, key, needId, status)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="CNR" value="«union»&lt;br&gt;&lt;b&gt;CreateNeedDraftResult&lt;/b&gt; (:28)&lt;hr&gt;{ok: true; outcome; need} | {ok: false; code}&lt;br&gt;devuelto por createNeedDraftService" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="330" height="95" as="geometry"/></mxCell><mxCell id="AG" value="«interface»&lt;br&gt;&lt;b&gt;AtomicNeedDraftGateway&lt;/b&gt; (ports:50)&lt;hr&gt;+ createDraft(command: AtomicNeedDraftCommand): Promise&amp;lt;unknown&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="330" height="120" as="geometry"/></mxCell><mxCell id="NR" value="«interface»&lt;br&gt;&lt;b&gt;NeedsRepository&lt;/b&gt; (needs.ports:27)&lt;hr&gt;+ list(accessToken, query): Page&amp;lt;NeedView&amp;gt;&lt;br&gt;+ get(accessToken, needId): NeedView&lt;br&gt;+ transition(accessToken, envelope, needId, status): NeedView" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="GW" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createNeedsRpcGateway({rpc, raw})&lt;/b&gt; (:66)&lt;hr&gt;- rpc: RpcInvoker&lt;br&gt;- raw: RawRpc&lt;hr&gt;+ repository: NeedsRepository&lt;br&gt;+ draftGatewayFor(accessToken): AtomicNeedDraftGateway" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="330" height="190" as="geometry"/></mxCell><mxCell id="RPC" value="«type»&lt;br&gt;&lt;b&gt;RpcInvoker&lt;/b&gt; (shared/persistence)&lt;hr&gt;&amp;lt;K extends string&amp;gt;(call: RpcCall&amp;lt;K&amp;gt;): Promise&amp;lt;RpcReply&amp;lt;K&amp;gt;&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="130" width="300" height="95" as="geometry"/></mxCell><mxCell id="NV" value="«value object»&lt;br&gt;&lt;b&gt;NeedView&lt;/b&gt; (needs.ports:11)&lt;hr&gt;needId · component: 'RBC'&lt;br&gt;requiredBloodType: NeedBloodType&lt;br&gt;targetConfirmations · confirmedIntentCount&lt;br&gt;siteId · radiusKm · expiresAt&lt;br&gt;urgency: NeedUrgency · status: NeedStatus" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="270" width="300" height="190" as="geometry"/></mxCell><mxCell id="EN" value="«enum» (dominio)&lt;br&gt;&lt;b&gt;NeedBloodType&lt;/b&gt; (need-draft.ts:2)&lt;br&gt;O_NEG · O_POS · A_NEG · A_POS · B_NEG · B_POS · AB_NEG · AB_POS&lt;hr&gt;&lt;b&gt;NeedUrgency&lt;/b&gt; (:5)&lt;br&gt;Normal · Urgente · Critica&lt;hr&gt;&lt;b&gt;ManualNeedStatus&lt;/b&gt; (need-state.ts:6)&lt;br&gt;activa · cerrada · cancelada" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="500" width="300" height="200" as="geometry"/></mxCell><mxCell id="DTO" value="«módulo»&lt;br&gt;&lt;b&gt;dto/validators.ts&lt;/b&gt;&lt;hr&gt;parseCreateNeedInput (:74)&lt;br&gt;parseCreatedNeedEnvelope (:92)&lt;br&gt;NeedDtoError (:24, clase)&lt;br&gt;valida contra el contrato generado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="330" height="130" as="geometry"/></mxCell><mxCell id="notes" value="Relaciones: registerNeedsRoutes depende de createNeedsService (needs) y de createNeedDraftService (createDraft). createNeedsService depende de NeedsRepository. createNeedsRpcGateway implementa NeedsRepository y AtomicNeedDraftGateway (esta última vía draftGatewayFor), y depende de RpcInvoker. createNeedDraftService depende de AtomicNeedDraftGateway y devuelve CreateNeedDraftResult.&lt;br&gt;Conexiones en composition.ts: :68–72 construye needsGateway = createNeedsRpcGateway({ rpc, raw }) y needs = createNeedsService(needsGateway.repository); :166–170 registra las rutas por petición, con createDraft = (accessToken) → createNeedDraftService(needsGateway.draftGatewayFor(accessToken)).&lt;br&gt;Dominio: ningún archivo de domain/ importa infraestructura; need-records no importa otros módulos." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="730" width="1440" height="110" as="geometry"/></mxCell><mxCell id="e1" value="createDraft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R" target="CDS"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="needs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R" target="NS"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CDS" target="AG"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="NS" target="NR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW" target="NR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW" target="AG"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="rpc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW" target="RPC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="NV" target="EN"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p22" name="22 Clases: donor-records"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="960" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Clases: donor-records (perfil, verificación de correo, altas asistidas y cambio de correo)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="st" value="Flecha punteada con punta abierta: dependencia («usa»). Punteada con triángulo hueco: realización («implementa»). Los recuadros con borde morado pertenecen a identity-institutions y se importan solo como tipo (import type). Entre paréntesis, archivo:línea." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="36" as="geometry"/></mxCell><mxCell id="h1" value="Adaptador de entrada (HTTP)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Aplicación y dominio" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h3" value="Puertos (interfaces)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h4" value="Adaptador de salida (RPC)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h5" value="shared/" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1580" y="98" width="300" height="20" as="geometry"/></mxCell><mxCell id="R22" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerDonorRecordsRoutes(app, deps)&lt;/b&gt; (:34)&lt;hr&gt;- donors: DonorRecordsService&lt;br&gt;- secrets: HttpSecrets + ipHmac&lt;hr&gt;7 grupos de rutas (ver notas)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="330" height="150" as="geometry"/></mxCell><mxCell id="SVC22" value="«factory»&lt;br&gt;&lt;b&gt;createDonorRecordsService(deps)&lt;/b&gt; (:65)&lt;hr&gt;- repository: DonorRecordsRepository&lt;br&gt;- sessions: Pick&amp;lt;SessionGateway&amp;gt;&lt;br&gt;- admin: AuthAdmin · limiter: RateLimiter&lt;br&gt;- keys: Pick&amp;lt;HmacKeyring&amp;gt;&lt;br&gt;- seal: SealEmail&lt;br&gt;- open: (context, sealed) → string&lt;hr&gt;+ registerDonor · verifyEmail · previewEmailVerification&lt;br&gt;+ createAssistedSignup · listAssistedSignups · getAssistedSignup · reissueAssistedLink&lt;br&gt;+ previewAssistedActivation · claimAssisted&lt;br&gt;+ previewEmailChange · verifyEmailChange&lt;br&gt;+ getProfile · completeOnboarding · updateParticipation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="330" height="340" as="geometry"/></mxCell><mxCell id="DOM" value="«dominio» · donor-records/domain&lt;br&gt;&lt;b&gt;donor-profile.ts&lt;/b&gt;&lt;hr&gt;DonorStatus (:5): pendiente_verificacion · incompleto · activo&lt;br&gt;DonorProfileDraft (:7) {name, declaredBloodType, isAvailable, approximateLocation}&lt;br&gt;canActivate (:18) · onboardingStatus (:26)&lt;hr&gt;&lt;b&gt;location.ts&lt;/b&gt;&lt;br&gt;ApproximateLocation (:3) {latitude, longitude}&lt;br&gt;validateApproximateLocation (:37) → LocationVerdict (:34)&lt;br&gt;isInsideOrOnBoundary (:22) · hasAtMostThreeDecimals (:8)&lt;br&gt;lima-polygon.ts: LIMA_POLYGON (:12)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="500" width="330" height="260" as="geometry"/></mxCell><mxCell id="DDR" value="«interface»&lt;br&gt;&lt;b&gt;DonorRecordsRepository&lt;/b&gt; (ports:59)&lt;br&gt;20 métodos (ISP: ver página 18)&lt;hr&gt;verificación: linkDonorAccount · reissueDonorVerification · donorVerificationPreview · verifyDonorEmail&lt;br&gt;contraseña: issuePasswordSetup · confirmPasswordSetup&lt;br&gt;altas asistidas: assistedActivationPreview · assistedSignupRecipient · linkAssistedAccount · createAssistedSignup · issueAssistedActivation · listAssistedSignups · getAssistedSignup · reissueAssistedLink&lt;br&gt;cambio de correo: emailChangePreview · consumeEmailChange · finishEmailChange&lt;br&gt;perfil: getProfile · completeOnboarding · updateParticipation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="330" height="360" as="geometry"/></mxCell><mxCell id="EMC" value="«application»&lt;br&gt;&lt;b&gt;email-change.ts&lt;/b&gt;&lt;hr&gt;sealEmailChange (:9) · openEmailChange (:15)&lt;br&gt;cifran y abren el correo nuevo con el keyring del outbox.&lt;br&gt;openEmailChange: donor-records (:114) y privacy-requests (:123); sealEmailChange: privacy-requests (:122)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="330" height="140" as="geometry"/></mxCell><mxCell id="RGW22" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createDonorRecordsRpcGateway(rpc, technical)&lt;/b&gt; (:50)&lt;hr&gt;- rpc: RpcInvoker (JWT del donante o admin)&lt;br&gt;- technical: RpcInvoker (api_technical)&lt;hr&gt;+ devuelve DonorRecordsRepository (20 métodos)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="330" height="170" as="geometry"/></mxCell><mxCell id="RPC22" value="«type»&lt;br&gt;&lt;b&gt;RpcInvoker&lt;/b&gt; (shared/persistence)&lt;hr&gt;&amp;lt;K extends string&amp;gt;(call: RpcCall&amp;lt;K&amp;gt;): Promise&amp;lt;RpcReply&amp;lt;K&amp;gt;&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="130" width="300" height="95" as="geometry"/></mxCell><mxCell id="AUTH" value="«interface»&lt;br&gt;&lt;b&gt;AuthAdmin&lt;/b&gt; (identity-institutions, auth-admin.ports:5)&lt;hr&gt;+ updatePassword · updateEmail · deleteInertUser · deleteAccount" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="330" height="90" as="geometry"/></mxCell><mxCell id="RL" value="«interface»&lt;br&gt;&lt;b&gt;RateLimiter&lt;/b&gt; (identity.ports:9)&lt;hr&gt;+ consume(bucket, subject, limit, windowSeconds): RateLimitDecision" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="330" height="80" as="geometry"/></mxCell><mxCell id="SEAL" value="«type»&lt;br&gt;&lt;b&gt;SealEmail&lt;/b&gt; (identity-institutions, action-tokens-service:22)&lt;hr&gt;(outboxId, payload) → sobre sellado (sealEmailPayload)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="330" height="80" as="geometry"/></mxCell><mxCell id="notes" value="Rutas: POST /api/v1/donor-registrations · GET y POST /api/v1/donor-email-verification-actions/:token · GET /api/v1/assisted-activation-actions/:token y POST …/claim · GET y POST /api/v1/donor-email-change-actions/:token · GET y POST /api/v1/hospitals/me/assisted-signups (con subrutas) · GET /api/v1/donors/me/profile, PUT onboarding-profile y PATCH profile.&lt;br&gt;Relaciones: registerDonorRecordsRoutes usa createDonorRecordsService. El servicio depende de DonorRecordsRepository (20 métodos), de AuthAdmin, RateLimiter y SealEmail (de identity-institutions, solo como tipo) y del dominio donor-profile y location. createDonorRecordsRpcGateway implementa DonorRecordsRepository y depende de RpcInvoker.&lt;br&gt;Conexiones en composition.ts: :96 createDonorRecordsRpcGateway(rpc, technicalRpc); :98 onPasswordChanged (identity-institutions llama a confirmPasswordSetup); :107–115 createDonorRecordsService({ repository, sessions, admin, limiter, keys, seal, open: openEmailChange }); :164 registerDonorRecordsRoutes." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="1440" height="140" as="geometry"/></mxCell><mxCell id="e1" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R22" target="SVC22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC22" target="AUTH"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="limiter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC22" target="RL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="seal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC22" target="SEAL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="usa dominio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC22" target="DOM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC22" target="DDR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RGW22" target="DDR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="rpc / technical" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RGW22" target="RPC22"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p23" name="23 Clases: identity-institutions"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Clases: identity-institutions (sesión y login, tokens de acción e instituciones)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="st" value="Flecha punteada con punta abierta: dependencia («usa»). Punteada con triángulo hueco: realización («implementa»). SessionGateway viene de shared/auth. Entre paréntesis, archivo:línea de cada declaración (bajo backend/src/modules/identity-institutions/)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="36" as="geometry"/></mxCell><mxCell id="h1" value="Adaptador de entrada (HTTP)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Aplicación" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h3" value="Puertos (interfaces)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h4" value="Adaptador de salida (RPC y Auth)" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="98" width="330" height="20" as="geometry"/></mxCell><mxCell id="h5" value="shared/ y tipos ajenos" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1580" y="98" width="300" height="20" as="geometry"/></mxCell><mxCell id="R-auth" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerAuthRoutes(app, deps)&lt;/b&gt; (auth.router:11)&lt;hr&gt;- auth: AuthService&lt;br&gt;- secrets: HttpSecrets + ipHmac&lt;hr&gt;POST /api/v1/auth/sessions · GET /api/v1/auth/session&lt;br&gt;GET /api/v1/auth/csrf-token · DELETE …/sessions/current&lt;br&gt;POST mfa-enrollments · mfa-verifications · step-up-verifications" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="330" height="190" as="geometry"/></mxCell><mxCell id="SVC-auth" value="«factory»&lt;br&gt;&lt;b&gt;createAuthService(sessions, identity, config)&lt;/b&gt; (:54)&lt;hr&gt;- sessions: SessionGateway&lt;br&gt;- identity: {actors, admission, limiter, publicKeys, userKeys}&lt;br&gt;- config: {keys, loginFailureFloorMs, sleep}&lt;hr&gt;+ createSession · enrollMfa · verifyMfa&lt;br&gt;+ verifyStepUp · signOut" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="330" height="200" as="geometry"/></mxCell><mxCell id="P-identity" value="«interface»&lt;br&gt;&lt;b&gt;identity.ports&lt;/b&gt; (identity.ports.ts)&lt;hr&gt;&lt;b&gt;RateLimiter&lt;/b&gt; (:9): consume(bucket, subject, limit, windowSeconds)&lt;br&gt;&lt;b&gt;PublicIdempotency&lt;/b&gt; (:16)&lt;br&gt;&lt;b&gt;UserKeyGuard&lt;/b&gt; (:21)&lt;br&gt;&lt;b&gt;SessionAdmission&lt;/b&gt; (:26)&lt;hr&gt;IdentityDependencies (:32): actors, admission, limiter, publicKeys, userKeys" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="330" height="250" as="geometry"/></mxCell><mxCell id="GW-identity" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createIdentityGateways(factory)&lt;/b&gt; (:60)&lt;hr&gt;devuelve actors, limiter, publicKeys, userKeys&lt;br&gt;limiter → RPC de cuotas (p_bucket, p_window)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="330" height="130" as="geometry"/></mxCell><mxCell id="GW-session" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createSessionAdmissionRpcGateway(technical)&lt;/b&gt; (:6)&lt;hr&gt;devuelve SessionAdmission (sesión técnica api_technical)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="290" width="330" height="100" as="geometry"/></mxCell><mxCell id="RPC22" value="«type»&lt;br&gt;&lt;b&gt;RpcInvoker&lt;/b&gt; (shared/persistence)&lt;hr&gt;&amp;lt;K extends string&amp;gt;(call: RpcCall&amp;lt;K&amp;gt;): Promise&amp;lt;RpcReply&amp;lt;K&amp;gt;&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="130" width="300" height="95" as="geometry"/></mxCell><mxCell id="SGW" value="«interface»&lt;br&gt;&lt;b&gt;SessionGateway&lt;/b&gt; (shared/auth/session-ports.ts:46)&lt;hr&gt;extiende SessionVerifier (:23)&lt;br&gt;+ signUp · signOut · verifyAccessToken&lt;br&gt;ActorResolver (:30) lo implementa identity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="260" width="300" height="130" as="geometry"/></mxCell><mxCell id="R-tok" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerActionTokenRoutes(app, deps)&lt;/b&gt; (action-tokens.router:9)&lt;hr&gt;- tokens: ActionTokensService&lt;br&gt;- secrets: HttpSecrets + ipHmac&lt;hr&gt;POST /api/v1/superadmin/hospital-admin-invitations&lt;br&gt;GET y POST /api/v1/hospital-admin-invitation-actions/:token…&lt;br&gt;POST /api/v1/auth/password-recovery-requests&lt;br&gt;POST /api/v1/auth/password-reset-actions/:token" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="330" height="190" as="geometry"/></mxCell><mxCell id="SEAL" value="«type»&lt;br&gt;&lt;b&gt;SealEmail&lt;/b&gt; (action-tokens-service:22)&lt;hr&gt;(outboxId, payload) → sobre sellado (email-delivery)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="330" height="80" as="geometry"/></mxCell><mxCell id="SVC-tok" value="«factory»&lt;br&gt;&lt;b&gt;createActionTokensService(deps)&lt;/b&gt; (:48)&lt;hr&gt;- onPasswordChanged: (userId) → Promise (callback de composition.ts:98)&lt;br&gt;- repository: ActionTokensRepository&lt;br&gt;- sessions: SessionGateway · admin: AuthAdmin&lt;br&gt;- limiter: RateLimiter · keys: HmacKeyring&lt;br&gt;- seal: SealEmail&lt;br&gt;- hospitalName: (accessToken, hospitalId) → Promise&amp;lt;string&amp;gt;&lt;hr&gt;+ inviteAdmin · claimAdminInvitation&lt;br&gt;+ requestPasswordRecovery · completePasswordReset" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="330" height="290" as="geometry"/></mxCell><mxCell id="P-tok" value="«interface»&lt;br&gt;&lt;b&gt;ActionTokensRepository&lt;/b&gt; (action-tokens.ports:35)&lt;hr&gt;+ inviteAdmin · adminInvitationPreview · linkAdminAccount&lt;br&gt;+ requestRecovery · consumePasswordReset&lt;br&gt;+ closeSessionBarrier" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="330" height="170" as="geometry"/></mxCell><mxCell id="P-admin" value="«interface»&lt;br&gt;&lt;b&gt;AuthAdmin&lt;/b&gt; (auth-admin.ports:5)&lt;hr&gt;+ updatePassword · updateEmail · deleteInertUser&lt;br&gt;+ revokeAllSessions · deleteAccount" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="330" height="130" as="geometry"/></mxCell><mxCell id="GW-tok" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createActionTokensRpcGateway(rpc, technical)&lt;/b&gt; (:10)&lt;hr&gt;devuelve ActionTokensRepository&lt;br&gt;rpc (usuario) o technical (api_technical) según la operación" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="330" height="130" as="geometry"/></mxCell><mxCell id="GW-admin" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createSupabaseAuthAdmin(config)&lt;/b&gt; (:35)&lt;hr&gt;implementa AuthAdmin con la Admin API de Supabase&lt;br&gt;solo los cinco métodos de la allowlist (ADR-006)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="600" width="330" height="130" as="geometry"/></mxCell><mxCell id="R-inst" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerInstitutionsRoutes(app, deps)&lt;/b&gt; (institutions.router:9)&lt;hr&gt;- institutions: InstitutionsService&lt;br&gt;- secrets: HttpSecrets&lt;hr&gt;GET y POST /api/v1/superadmin/hospitals · PATCH …/:hospitalId&lt;br&gt;sedes, membresías, configuración, auditoría y cola de tareas (superadmin)&lt;br&gt;GET /api/v1/hospitals/me/sites" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="330" height="150" as="geometry"/></mxCell><mxCell id="SVC-inst" value="«factory»&lt;br&gt;&lt;b&gt;createInstitutionsService(repository)&lt;/b&gt; (:17)&lt;hr&gt;- repository: InstitutionsRepository&lt;hr&gt;hospitales, sedes, membresías, configuración, auditoría y cola de tareas (superadmin)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="330" height="150" as="geometry"/></mxCell><mxCell id="P-inst" value="«interface»&lt;br&gt;&lt;b&gt;InstitutionsRepository&lt;/b&gt; (institutions.ports:48)&lt;hr&gt;value objects: HospitalView (:7) · SiteView (:11) · MembershipView (:17)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="780" width="330" height="150" as="geometry"/></mxCell><mxCell id="GW-inst" value="«factory · adaptador de salida»&lt;br&gt;&lt;b&gt;createInstitutionsRpcGateway(rpc)&lt;/b&gt; (:67)&lt;hr&gt;devuelve InstitutionsRepository (RPC de superadmin y de administrador de hospital)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="780" width="330" height="110" as="geometry"/></mxCell><mxCell id="notes" value="Relaciones: createAuthService depende de SessionGateway (shared/auth), de IdentityDependencies y de AuthServiceConfig. createActionTokensService depende de ActionTokensRepository, AuthAdmin, RateLimiter, SessionGateway y SealEmail; recibe onPasswordChanged como función, no el repositorio de donantes. createInstitutionsService depende de InstitutionsRepository. Las implementaciones están en infrastructure/ y son las únicas que llaman a RPC o a la Admin API.&lt;br&gt;Conexiones en composition.ts: :67 createIdentityGateways(supabase); :73–74 institutionsRepository → createInstitutionsService; :84 createAuthService(sessions, {...identity, admission: createSessionAdmissionRpcGateway(technicalRpc)}, {keys, loginFailureFloorMs: 400}); :95 createSupabaseAuthAdmin(config); :97–99 createActionTokensService({ onPasswordChanged (:98), repository: createActionTokensRpcGateway(rpc, technicalRpc) (:99), admin, limiter: identity.limiter, seal, hospitalName }); :161–163 registerAuthRoutes, registerInstitutionsRoutes y registerActionTokenRoutes." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="440" y="960" width="1440" height="120" as="geometry"/></mxCell><mxCell id="e1" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R-auth" target="SVC-auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="usa puertos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC-auth" target="P-identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-identity" target="P-identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-session" target="P-identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="rpc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-identity" target="RPC22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R-tok" target="SVC-tok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC-tok" target="P-tok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC-tok" target="P-admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="seal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC-tok" target="SEAL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-tok" target="P-tok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-admin" target="P-admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="rpc / technical" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-tok" target="RPC22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R-inst" target="SVC-inst"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SVC-inst" target="P-inst"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-inst" target="P-inst"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p24" name="24 Clases: email-delivery"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Clases: email-delivery (outbox, envío y webhook)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Dependencias hacia puertos (punteada con punta abierta); realización de interfaces (punteada con triángulo hueco). Firmas y referencias verificadas en backend/src/modules/email-delivery/." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="32" as="geometry"/></mxCell><mxCell id="h1" value="Entrada y ciclo de trabajo" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="300" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Aplicación y dominio" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="115" width="330" height="20" as="geometry"/></mxCell><mxCell id="h3" value="Puertos" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="115" width="340" height="20" as="geometry"/></mxCell><mxCell id="h4" value="Adaptadores de salida" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="115" width="330" height="20" as="geometry"/></mxCell><mxCell id="h5" value="RPC y proveedor externo" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1590" y="115" width="280" height="20" as="geometry"/></mxCell><mxCell id="R-webhook" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerResendWebhookRoutes(app, deps)&lt;/b&gt; (resend-webhook.router.ts:12)&lt;hr&gt;POST /api/v1/email-delivery/webhooks/resend&lt;br&gt;Cuerpo crudo JSON, límite 64 KB; se monta antes de express.json (composition.ts:138)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="300" height="160" as="geometry"/></mxCell><mxCell id="U-ingester" value="«factory / caso de uso»&lt;br&gt;&lt;b&gt;createWebhookIngester({ gateway, secret, now? })&lt;/b&gt; (ingest-webhook.ts:17)&lt;hr&gt;+ handle(headers: SvixHeaders, rawBody: Buffer): Promise&lt;WebhookResult&gt;&lt;hr&gt;Verifica firma antes de parsear; valida contrato; deduplica por svix-id vía gateway." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="330" height="185" as="geometry"/></mxCell><mxCell id="U-signature" value="«funciones puras»&lt;br&gt;&lt;b&gt;verifyWebhook(secret, headers, rawBody, nowSeconds): boolean&lt;/b&gt; (webhook-signature.ts:23)&lt;hr&gt;Svix HMAC-SHA256; tolerancia ±300 s. EVENT_TO_DELIVERY (:39): sent, delivered, bounced y failed." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="370" width="330" height="145" as="geometry"/></mxCell><mxCell id="P-outbox" value="«interface»&lt;br&gt;&lt;b&gt;OutboxGateway&lt;/b&gt; (outbox.ports.ts:27)&lt;hr&gt;+ claim(limit): Promise&lt;readonly ClaimedMessage[]&gt;&lt;br&gt;+ recordAttempt(record): Promise&lt;boolean&gt;&lt;br&gt;+ expire(): Promise&lt;{ expired, exhausted }&gt;&lt;br&gt;+ ingestEvent(event): Promise&lt;{ duplicate, matched }&gt;&lt;hr&gt;Puerto compartido por procesador y webhook." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="275" width="340" height="250" as="geometry"/></mxCell><mxCell id="GW-outbox" value="«factory · adaptador RPC»&lt;br&gt;&lt;b&gt;createOutboxRpcGateway(rpc, accessToken, invalidate)&lt;/b&gt; (outbox-rpc-gateway.ts:25)&lt;hr&gt;Mapea claim / recordAttempt / expire / ingestEvent a RPC worker_* y ingest_email_event.&lt;br&gt;Usa JWT técnico de worker; no service_role." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="275" width="330" height="195" as="geometry"/></mxCell><mxCell id="RPC" value="«shared»&lt;br&gt;&lt;b&gt;RpcInvoker&lt;/b&gt;&lt;hr&gt;Invocación de funciones Postgres/Supabase mediante sesión técnica." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="310" width="280" height="110" as="geometry"/></mxCell><mxCell id="WorkerLoop" value="«factory»&lt;br&gt;&lt;b&gt;createWorkerLoop({ processor, gateway, pollMs, … })&lt;/b&gt; (worker-loop.ts:21)&lt;hr&gt;+ tick() · start() · stop()&lt;br&gt;Sin ciclos solapados; registra errores por código y continúa." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="625" width="300" height="155" as="geometry"/></mxCell><mxCell id="Processor" value="«factory»&lt;br&gt;&lt;b&gt;createOutboxProcessor(deps)&lt;/b&gt; (process-outbox.ts:30)&lt;hr&gt;+ runOnce(limit = 5): Promise&lt;BatchSummary&gt; (:65)&lt;hr&gt;claim → descifra y valida payload → allowlist → renderiza → send → recordAttempt. Clave idempotente estable por mensaje; no registra destinatario, asunto ni token." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="600" width="330" height="255" as="geometry"/></mxCell><mxCell id="Policy" value="«dominio puro»&lt;br&gt;&lt;b&gt;retry-policy.ts&lt;/b&gt;&lt;hr&gt;MAX_CALLS = 6&lt;br&gt;Backoff (min): [1, 2, 5, 10, 20]&lt;br&gt;nextDelayMs: jitter ±20 %; classify distingue ok / transitorio / permanente / incierto.&lt;hr&gt;&lt;b&gt;delivery-state.ts&lt;/b&gt;&lt;br&gt;Estados: pendiente, enviada, entregada, fallida. advance no retrocede; una fallida es final en esta función y un rebote no invalida una entrega previa." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="300" height="220" as="geometry"/></mxCell><mxCell id="Payload" value="«helpers / registro»&lt;br&gt;&lt;b&gt;email-payload.ts&lt;/b&gt;&lt;hr&gt;EmailPayload sellado con outboxId como AAD&lt;br&gt;+ sealEmailPayload · openEmailPayload · renderEmail&lt;hr&gt;`templates/index.ts`: EmailKind y renderTemplate. Token y, cuando aplica, destinatario cifrados; el destinatario también puede leerse de auth.users." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="885" width="330" height="155" as="geometry"/></mxCell><mxCell id="P-sender" value="«interface»&lt;br&gt;&lt;b&gt;EmailSender&lt;/b&gt; (email-sender.ts:19)&lt;hr&gt;+ send(message: EmailMessage): Promise&lt;SendResult&gt;&lt;hr&gt;EmailMessage: to, subject, text, html, idempotencyKey (estable entre reintentos). SendResult.kind: OutcomeClass." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="660" width="340" height="170" as="geometry"/></mxCell><mxCell id="GW-resend" value="«factory · adaptador»&lt;br&gt;&lt;b&gt;createResendSender({ apiKey, from, fetch?, timeoutMs? })&lt;/b&gt; (resend-sender.ts:60)&lt;hr&gt;Usa Idempotency-Key; clasifica respuesta, timeout y red. Nunca lanza ni registra destinatario, asunto, cuerpo o API key." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="330" height="155" as="geometry"/></mxCell><mxCell id="GW-fake" value="«adaptador de prueba»&lt;br&gt;&lt;b&gt;FakeEmailSender&lt;/b&gt; (fake-sender.ts:9)&lt;hr&gt;Implementa EmailSender&lt;br&gt;records conserva tipo, clave idempotente y hora; no PII ni cuerpo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="835" width="330" height="125" as="geometry"/></mxCell><mxCell id="ResendAPI" value="«proveedor externo»&lt;br&gt;&lt;b&gt;Resend API&lt;/b&gt;&lt;hr&gt;POST email con clave idempotente; respuesta clasificada por el adaptador." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="665" width="280" height="115" as="geometry"/></mxCell><mxCell id="composition" value="Composición verificada: composition.ts:90–91 crea el ingester y comparte createOutboxRpcGateway; :138 registra el webhook antes de express.json. composition-worker.ts:31–58 compone gateway, ResendSender o FakeEmailSender, processor y loop en un proceso worker separado." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="990" width="1070" height="75" as="geometry"/></mxCell><mxCell id="e1" value="entrega cuerpo crudo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="R-webhook" target="U-ingester"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="verifica firma / mapea evento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U-ingester" target="U-signature"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ingestEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U-ingester" target="P-outbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-outbox" target="P-outbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="RPC técnico" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-outbox" target="RPC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="itera" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="WorkerLoop" target="Processor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="claim / recordAttempt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Processor" target="P-outbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="usa política" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Processor" target="Policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="abre / renderiza" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Processor" target="Payload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Processor" target="P-sender"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-resend" target="P-sender"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-fake" target="P-sender"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GW-resend" target="ResendAPI"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p25" name="25 Clases: privacy-requests e invitation-coordination"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Clases: privacy-requests (correcciones y eliminación, F7)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Módulo de solicitudes de corrección/eliminación de donantes. invitation-coordination solo tiene dominio puro (ver página 20) y no tiene router, servicio ni gateway. Solo importa el tipo SealEmail de identity-institutions (privacy-requests-service.ts:6); el eraser lo inyecta la composición." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="32" as="geometry"/></mxCell><mxCell id="h0" value="HTTP" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="400" height="20" as="geometry"/></mxCell><mxCell id="h1" value="Aplicación" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="105" width="520" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Puertos y adaptadores" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1090" y="105" width="770" height="20" as="geometry"/></mxCell><mxCell id="Router" value="«router»&lt;br&gt;&lt;b&gt;registerPrivacyRequestsRoutes&lt;/b&gt; (privacy-requests.router.ts:35)&lt;hr&gt;Donante: GET/POST /api/v1/donors/me/correction-requests; GET …/:requestId&lt;br&gt;Superadmin: GET /superadmin/correction-requests; GET …/:requestId; PATCH …/:requestId&lt;br&gt;POST /superadmin/access-grants (step-up)&lt;br&gt;GET …/:requestId/donor-data&lt;br&gt;POST …/:requestId/executions (step-up)&lt;hr&gt;Deps: PrivacyRequestsRouterDependencies { privacy, secrets }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="400" height="330" as="geometry"/></mxCell><mxCell id="Service" value="«servicio»&lt;br&gt;&lt;b&gt;createPrivacyRequestsService&lt;/b&gt; (privacy-requests-service.ts:49)&lt;hr&gt;+ createOwn(accessToken, key, input: CorrectionInput)&lt;br&gt;+ decide(accessToken, key, requestId, decision, reason)&lt;br&gt;+ createGrant(…)&lt;br&gt;+ contextualData(accessToken, requestId, grantId): ContextualView&lt;br&gt;+ execute(accessToken, key, requestId, grantId)&lt;hr&gt;Deps: repository, eraser, sealEmailValue, openEmailValue, seal, ledgerHmac" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="140" width="520" height="330" as="geometry"/></mxCell><mxCell id="Repo" value="«interface»&lt;br&gt;&lt;b&gt;PrivacyRequestsRepository&lt;/b&gt; (privacy-requests.ports.ts:62)&lt;hr&gt;createOwn · listOwn · getOwn&lt;br&gt;list · get · decide(…, 'aprobada' | 'rechazada', reason)&lt;br&gt;createGrant · contextualData · execute&lt;br&gt;executionSubject · issueEmailChange · finishDeletion · failExecution&lt;hr&gt;Tipos: RequestStatus (pendiente, aprobada, rechazada, en_ejecucion, completada, fallida); RequestType (correccion | eliminacion); RequestedField (name, email, declaredBloodType, deletion); GrantAction (review | execute)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="770" height="330" as="geometry"/></mxCell><mxCell id="Gateway" value="«adaptador»&lt;br&gt;&lt;b&gt;createPrivacyRequestsRpcGateway&lt;/b&gt;(rpc, technical) (…-rpc-gateway.ts:56)&lt;br&gt;&lt;b&gt;createPrivacyPurgeRpcGateway&lt;/b&gt;(worker) (:158)&lt;hr&gt;parseRequest(value): CorrectionRequestView (:14). Una RPC por comando (ADR-003)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="770" height="140" as="geometry"/></mxCell><mxCell id="Eraser" value="«interface»&lt;br&gt;&lt;b&gt;AccountEraser&lt;/b&gt; (ports.ts:95)&lt;hr&gt;+ deleteAccount(userId): Promise&amp;lt;void&amp;gt;&lt;br&gt;La composición lo adapta a AuthAdmin.deleteAccount (ADR-006, solo V15). El worker no lo recibe." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="500" width="520" height="120" as="geometry"/></mxCell><mxCell id="Purge" value="«job del worker»&lt;br&gt;&lt;b&gt;createPurgeJob&lt;/b&gt;({ repository, ledgerHmac }) (purge-job.ts:20)&lt;hr&gt;PrivacyPurgeRepository: purge · purgeAuthAccounts(limit) · finishDeletion · failExecution" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="650" width="520" height="110" as="geometry"/></mxCell><mxCell id="e0" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Router" target="Service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="depende (puerto)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Service" target="Repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Gateway" target="Repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="depende (puerto)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Service" target="Eraser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Relaciones verificadas en backend/src/composition.ts:119-126 y :165: createPrivacyRequestsService recibe repository (gateway RPC), eraser, sealEmailValue/openEmailValue/seal y ledgerHmac; registerPrivacyRequestsRoutes(app, { privacy, secrets }). El PurgeJob lo arma el worker, no la API. Las operaciones de ejecución y concesión exigen step-up (AAL2 reciente)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="1810" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p26" name="26 Clases: shared (auth, http, persistencia, criptografía)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Clases: shared (auth, http, persistencia, criptografía)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Piezas transversales de backend/src/shared. Los módulos las consumen; shared no importa de los módulos." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="32" as="geometry"/></mxCell><mxCell id="h0" value="auth/" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="440" height="20" as="geometry"/></mxCell><mxCell id="h1" value="http/" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="105" width="440" height="20" as="geometry"/></mxCell><mxCell id="h2" value="persistence/ y crypto/" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="990" y="105" width="440" height="20" as="geometry"/></mxCell><mxCell id="h3" value="audit/ y observability/" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1460" y="105" width="400" height="20" as="geometry"/></mxCell><mxCell id="Auth" value="«middleware / puertos»&lt;br&gt;&lt;b&gt;authenticate&lt;/b&gt;({ verifier, actors, refreshGate, renewalPolicy }) (authenticate.ts:44)&lt;br&gt;RenewalPolicy: normal | skip | lenient&lt;hr&gt;&lt;b&gt;guards.ts&lt;/b&gt;: requireSession, requireRole(...roles), requireAal2, requireStepUp(maxAge, now), requireActiveMembership, isStepUpFresh&lt;hr&gt;&lt;b&gt;principal.ts&lt;/b&gt;: PrincipalRole (donante | admin_hospitalario | superadmin); Principal; setPrincipal / findPrincipal / requirePrincipal&lt;hr&gt;&lt;b&gt;session-ports.ts&lt;/b&gt;: SessionVerifier, ActorResolver, SessionGateway (extiende SessionVerifier), TokenPair, VerifiedClaims, ActorInfo&lt;hr&gt;createSupabaseSessionGateway (supabase-session.ts:42) implementa SessionGateway.&lt;br&gt;createTechnicalSession (technical-session.ts:16): sesión del rol api_technical.&lt;br&gt;setSessionCookies / clearSessionCookies; parseClaims" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="440" height="520" as="geometry"/></mxCell><mxCell id="Http" value="«middleware / utilidades»&lt;br&gt;&lt;b&gt;requireCsrf&lt;/b&gt;(secret, allowedOrigins) (csrf-guard.ts:13)&lt;br&gt;&lt;b&gt;originGuard&lt;/b&gt;(allowedOrigins) (origin-guard.ts:11)&lt;br&gt;&lt;b&gt;edgeGuard&lt;/b&gt;(secret, onReject) (edge-guard.ts:20), cabecera x-edge-secret&lt;hr&gt;&lt;b&gt;errors.ts&lt;/b&gt;: ApiError (:54), ERROR_STATUS, toPublicError, createErrorHandler, notFoundHandler&lt;hr&gt;&lt;b&gt;idempotency.ts&lt;/b&gt;: requireIdempotencyKey(req); fingerprint reexportado desde crypto/&lt;br&gt;cookies, client-ip, correlation-id, respond, route-helpers, security-headers, sensitive-response" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="440" height="520" as="geometry"/></mxCell><mxCell id="Persist" value="«persistencia (ADR-003)»&lt;br&gt;&lt;b&gt;createRpcInvoker&lt;/b&gt;(supabase) → RpcInvoker (rpc-invoker.ts)&lt;br&gt;&lt;b&gt;createTechnicalInvoker&lt;/b&gt;(rpc, token, invalidate) (technical-rpc.ts)&lt;br&gt;callRpc, rpc-reply, createSupabaseFactory (cliente por petición: forUser(accessToken))&lt;br&gt;cursor.ts: cursor firmado; page.ts: Page / PageQuery; errors.ts: PersistenceUnavailableError; schema-version.ts" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="140" width="440" height="300" as="geometry"/></mxCell><mxCell id="Crypto" value="«criptografía»&lt;br&gt;&lt;b&gt;csrf.ts&lt;/b&gt;: createCsrfToken(secret, sessionId), verifyCsrfToken&lt;br&gt;&lt;b&gt;hmac.ts&lt;/b&gt;: hmacSha256Hex, hmacEmailSubject, deriveHmacKey(secret, purpose), deriveHmacKeyring → HmacKeyring&lt;br&gt;&lt;b&gt;tokens.ts&lt;/b&gt;: generateActionToken, hashToken, safeEqual&lt;br&gt;&lt;b&gt;outbox-cipher.ts&lt;/b&gt;: sealPayload / openPayload(OutboxKeyring), SealedPayloadError&lt;br&gt;fingerprint(fields)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="470" width="440" height="190" as="geometry"/></mxCell><mxCell id="Audit" value="«auditoría»&lt;br&gt;&lt;b&gt;createDenialAuditor&lt;/b&gt;(technical) (denial-audit.ts:19)&lt;br&gt;DenialKind: acceso | conflicto | limite; denialKindFor(status)&lt;br&gt;DenialAuditor({ userId, kind, operation }) = RNF-AUD-01" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="140" width="400" height="200" as="geometry"/></mxCell><mxCell id="Obs" value="«observabilidad»&lt;br&gt;&lt;b&gt;Logger&lt;/b&gt; (logger.ts:34) · createLogger(write, now) (:56)&lt;br&gt;LogLevel: info | warn | error; LogEvent como unión cerrada (sin PII)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="370" width="400" height="170" as="geometry"/></mxCell><mxCell id="e2" value="RPC técnica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Audit" target="Persist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Los routers de cada módulo componen estas piezas en backend/src/composition.ts (authenticate se monta en /api; registerXRoutes recibe secrets { csrf, cursor, allowedOrigins }). El rol service_role solo se usa según la allowlist de ADR-006 (service-role-allowlist.test.ts)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="1810" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p27" name="27 Conexiones de composición (diagrama de objetos)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Conexiones de composición (diagrama de objetos)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Instancias creadas por buildApplication(config, _logger) en backend/src/composition.ts:63 y cómo se conectan. Las flechas son «recibe como dependencia»." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1800" height="32" as="geometry"/></mxCell><mxCell id="h0" value="Infraestructura compartida" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="440" height="20" as="geometry"/></mxCell><mxCell id="h1" value="Gateways y servicios" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="105" width="700" height="20" as="geometry"/></mxCell><mxCell id="h2" value="Routers montados en /api" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1250" y="105" width="610" height="20" as="geometry"/></mxCell><mxCell id="Infra" value="«objetos»&lt;br&gt;supabase = createSupabaseFactory(config) (:64)&lt;br&gt;sessions = createSupabaseSessionGateway(config) (:65)&lt;br&gt;rpc = createRpcInvoker(supabase) (:66)&lt;br&gt;identity = createIdentityGateways(supabase) (:67)&lt;br&gt;technicalSession = createTechnicalSession(…) (:79)&lt;br&gt;technicalRpc = createTechnicalInvoker(rpc, …) (:83)&lt;br&gt;hmacKeys = deriveHmacKeyring(emailHmac) (:75)&lt;br&gt;authAdmin = createSupabaseAuthAdmin(config) (:95)&lt;br&gt;ledgerKey = deriveHmacKey(emailHmac, 'deletion-ledger')" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="440" height="600" as="geometry"/></mxCell><mxCell id="Svc" value="«objetos»&lt;br&gt;needsGateway = createNeedsRpcGateway({ rpc, raw }) → needs = createNeedsService(needsGateway.repository)&lt;br&gt;institutionsRepository = createInstitutionsRpcGateway(rpc) → institutions = createInstitutionsService(…)&lt;br&gt;auth = createAuthService(sessions, { …identity, admission }, { keys, loginFailureFloorMs: 400 })&lt;br&gt;actionTokens = createActionTokensService({ onPasswordChanged: donorRepository.confirmPasswordSetup, repository, sessions, admin, limiter, keys, seal, hospitalName })&lt;br&gt;donorRepository = createDonorRecordsRpcGateway(rpc, technicalRpc) → donors = createDonorRecordsService({ repository, sessions, admin, limiter, keys, seal, open })&lt;br&gt;privacy = createPrivacyRequestsService({ repository, eraser, sealEmailValue, openEmailValue, seal, ledgerHmac })&lt;br&gt;webhookIngester = createWebhookIngester({ gateway, secret }) (solo si hay resendWebhookSecret)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="700" height="600" as="geometry"/></mxCell><mxCell id="Routes" value="«routers»&lt;br&gt;registerHealthRoutes(app, { readiness, expectedSchemaVersion })&lt;br&gt;registerAuthRoutes(app, { auth, secrets })&lt;br&gt;registerInstitutionsRoutes(app, { institutions, secrets })&lt;br&gt;registerActionTokenRoutes(app, { tokens: actionTokens, secrets })&lt;br&gt;registerDonorRecordsRoutes(app, { donors, secrets })&lt;br&gt;registerPrivacyRequestsRoutes(app, { privacy, secrets })&lt;br&gt;registerNeedsRoutes(app, { needs, createDraft, secrets })&lt;br&gt;registerResendWebhookRoutes (mountBeforeJson, cuerpo crudo)&lt;hr&gt;authenticate({ verifier: sessions, actors: identity.actors, renewalPolicy, refreshGate }) se monta antes en /api&lt;br&gt;auditDenial = createDenialAuditor(technicalRpc)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="610" height="600" as="geometry"/></mxCell><mxCell id="e0" value="inyecta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Infra" target="Svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="inyecta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Svc" target="Routes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="El worker se compone aparte en backend/src/composition-worker.ts:31 (buildWorker(config, logger, overrides)); no recibe eraser. Dependencias entre módulos: donor-records importa tres tipos de identity-institutions y privacy-requests importa SealEmail; invitation-coordination importa NeedBloodType de need-records (ver página 02)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="1810" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
