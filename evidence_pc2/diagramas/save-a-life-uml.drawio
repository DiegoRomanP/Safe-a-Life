nderTemplate()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="RENDERERS[kind]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="K extends EmailKind" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="data: EmailTemplateData[K]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="380"/><mxPoint x="225" y="380"/></Array></mxGeometry></mxCell><mxCell id="c63" value="devuelven" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="todas usan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;Añadir un tipo de email&lt;/b&gt;: 1) nueva función en templates/x.ts; 2) añadir la clave a EMAIL_KINDS y EmailTemplateData; 3) añadir la entrada en RENDERERS (si falta, el compilador falla). renderTemplate no se modifica: abierto a extensión, cerrado a modificación.&lt;br&gt;&lt;i&gt;Matiz&lt;/i&gt;: el CHECK de app.email_outbox.kind también lista los tipos, así que el SQL necesita una migración nueva." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="900" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="14 Chain of Responsibility"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Patrón Chain of Responsibility — middlewares y guards de Express&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1940" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Cada guard es un RequestHandler: si la condición se cumple llama a next() y pasa al siguiente eslabón; si no, corta la cadena con next(ApiError).&lt;br&gt;guardsFor(secrets) compone cadenas reutilizables por rol; las rutas las aplican con el operador spread (...guards.adminWrite)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1940" height="52" as="geometry"/></mxCell><mxCell id="c3" value="«interface»&lt;br&gt;&lt;b&gt;RequestHandler (Express)&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="207" height="62" as="geometry"/></mxCell><mxCell id="c4" value="+ (req, res, next): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="40" width="207" height="18" as="geometry"/></mxCell><mxCell id="c5" value="«factory»&lt;br&gt;&lt;b&gt;guardsFor(secrets)&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="246" height="160" as="geometry"/></mxCell><mxCell id="c6" value="shared/http/route-helpers.ts" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c5"><mxGeometry x="0" y="40" width="246" height="18" as="geometry"/></mxCell><mxCell id="c7" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portCons