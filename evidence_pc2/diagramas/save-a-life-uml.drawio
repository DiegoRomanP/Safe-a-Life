><mxPoint x="940" y="519" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="8. createDraft(token)(body, contexto, {key})" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="555" as="sourcePoint"/><mxPoint x="1145" y="555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="591" as="sourcePoint"/><mxPoint x="1145" y="647" as="targetPoint"/><Array as="points"><mxPoint x="1173" y="591"/><mxPoint x="1173" y="647"/></Array></mxGeometry></mxCell><mxCell id="c23" value="9. revalida rol, AAL2 y membresía; parseCreateNeedInput; fingerprint → hash" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1179" y="587" width="161" height="64" as="geometry"/></mxCell><mxCell id="c24" value="10. createDraft(command)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="669" as="sourcePoint"/><mxPoint x="1350" y="669" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="11. rpc(p_key, p_hash, …)&lt;br&gt;con el JWT del usuario" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="705" as="sourcePoint"/><mxPoint x="1555" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1555" y="751" as="sourcePoint"/><mxPoint x="1555" y="833" as="targetPoint"/><Array as="points"><mxPoint x="1583" y="751"/><mxPoint x="1583" y="833"/></Array></mxGeometry></mxCell><mxCell id="c27" value="12. UNA transacción: membresía → hospital, claim_idempotency, INSERT app.needs, write_audit, complete_idempotency" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1589" y="747" width="161" height="90" as="geometry"/></mxCell><mxCell id="c28" value="13. {kind: 'created', owner, need}" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1555" y="855" as="sourcePoint"/><mxPoint x="1350" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="891" as="sourcePoint"/><mxPoint x="1350" y="933" as="targetPoint"/><Array as="points"><mxPoint x="1378" y="891"/><mxPoint x="1378" y="933"/></Array></mxGeometry></mxCell><mxCell id="c30" value="14. toDraftReply(): traduce el kind (capa anticorrupción)" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1384" y="887" width="161" height="50" as="geometry"/></mxCell><mxCell id="c31" value="15. reply" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="955" as="sourcePoint"/><mxPoint x="1145" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="991" as="sourcePoint"/><mxPoint x="1145" y="1023" as="targetPoint"/><Array as="points"><mxPoint x="1173" y="991"/><mxPoint x="1173" y="1023"/></Array></mxGeometry></mxCell><mxCell id="c33" value="16. interpret(): forma exacta y proyección" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1179" y="987" width="161" height="40" as="geometry"/></mxCell><mxCell id="c34" value="17. {ok: true, need}" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="1045" as="sourcePoint"/><mxPoint x="940" y="1045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="1081" as="sourcePoint"/><mxPoint x="940" y="1123" as="targetPoint"/><Array as="points"><mxPoint x="968" y="1081"/><mxPoint x="968" y="1123"/></Array></mxGeometry></mxCell><mxCell id="c36" value="18. ok(createNeed, need): valida la respuesta contra el contrato" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="974" y="1077" width="161" height="50" as="geometry"/></mxCell><mxCell id="c37" value="19. 201 {data: need}" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="1145" as="sourcePoint"/><mxPoint x="120" y="1145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Si un eslabón falla&lt;/b&gt;: next(ApiError) → createErrorHandler → 401/403 con cuerpo JSON público; requestLogger registra la denegación con auditDenial (RNF-AUD-01). Si la RPC devuelve otro kind (forbidden, site_unusable, payload_conflict, rate_limited…), el caso de uso lo traduce a 403/422/409/429." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1211" width="1000" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p07" name="07 Secuencia: envío de email y webhook"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1350" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Secuencia — worker de email (outbox) y webhook de Resend&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1700" height="32" as="geometry"/></mxCell><mxCell id="c2" value="El worker reclama mensajes del outbox, los descifra, renderiza la plantilla, envía con Resend y registra el intento. Más tarde Resend avisa por webhook." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1700" height="36" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;createWorkerLoop&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;createOutboxProcessor&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="245" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;OutboxGateway&lt;/b&gt;&lt;br&gt;createOutboxRpcGateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;email-payload.ts&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="655" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;templates/index.ts&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;EmailSender&lt;/b&gt;&lt;br&gt;createResendSender" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1065" y="110" width="165" height="1195" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Resend&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="110" width="1