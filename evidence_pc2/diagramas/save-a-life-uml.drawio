<mxfile host="drawio" agent="save-a-life gen-uml" version="24.0.0"><diagram id="p00" name="00 Leyenda y convención"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="720" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Leyenda y convención UML&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1640" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Cómo leer todos los diagramas de este archivo. El backend está escrito en TypeScript con funciones fábrica y objetos congelados&lt;br&gt;(Object.freeze), casi sin clases: la notación UML se adapta como se indica abajo. Las rutas son relativas a backend/src salvo que se diga otra cosa." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="52" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Colores por capa&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;HTTP (entrada)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;routers, middlewares&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Aplicación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;casos de uso y puertos&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="235" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Dominio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reglas puras, sin I/O&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Infraestructura&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;adaptadores RPC, Resend&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="645" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;funciones SQL, tablas, RLS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="850" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Compartido&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;backend/src/shared/*&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1055" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Composition root&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ensambla dependencias&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d9f2f0;strokeColor=#2b7a78;" vertex="1" parent="1"><mxGeometry x="1260" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Externo / plataforma&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Vercel, Render, Supabase, Resend&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1465" y="135" width="190" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Relaciones&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="300" height="24" as="geometry"/></mxCell><mxCell id="c13" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="262" width="110" height="34" as="geometry"/></mxCell><mxCell id="c14" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="262" width="110" height="34" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;endSize=12;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;implementa / realiza&lt;/b&gt;&lt;br&gt;el adaptador cumple el puerto (interface)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="260" width="330" height="44" as="geometry"/></mxCell><mxCell id="c17" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="328" width="110" height="34" as="geometry"/></mxCell><mxCell id="c18" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="328" width="110" height="34" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;depende de / usa&lt;/b&gt;&lt;br&gt;lo importa o lo recibe por parámetro" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="326" width="330" height="44" as="geometry"/></mxCell><mxCell id="c21" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="394" width="110" height="34" as="geometry"/></mxCell><mxCell id="c22" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="394" width="110" height="34" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;asociación / llama&lt;/b&gt;&lt;br&gt;guarda una referencia y la invoca" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="392" width="330" height="44" as="geometry"/></mxCell><mxCell id="c25" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="110" height="34" as="geometry"/></mxCell><mxCell id="c26" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="110" height="34" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;startArrow=diamondThin;startFill=1;startSize=16;endSize=10;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;composición&lt;/b&gt;&lt;br&gt;el todo crea y contiene a sus partes" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="458" width="330" height="44" as="geometry"/></mxCell><mxCell id="c29" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="526" width="110" height="34" as="geometry"/></mxCell><mxCell id="c30" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="526" width="110" height="34" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;generalización&lt;/b&gt;&lt;br&gt;hereda de (p. ej. ApiError extends Error)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="524" width="330" height="44" as="geometry"/></mxCell><mxCell id="c33" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="110" height="34" as="geometry"/></mxCell><mxCell id="c34" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="592" width="110" height="34" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=cross;endFill=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;endSize=10;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;acceso prohibido&lt;/b&gt;&lt;br&gt;no existe el privilegio o la ruta" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="465" y="590" width="330" height="44" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Estereotipos&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="225" width="300" height="24" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«factory» createX(deps)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Función fábrica que devuelve un objeto congelado. Se dibuja como clase: los atributos privados (−) son sus dependencias capturadas y las operaciones (+) son los métodos del objeto devuelto." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="262" width="800" height="58" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«interface» XRepository&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Puerto: interfaz TypeScript en *.ports.ts. La aplicación la define y la infraestructura la implementa." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="324" width="800" height="58" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«type» / «union»&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Alias de tipo. «union» = unión discriminada por el campo kind." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="386" width="800" height="58" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«module» archivo.ts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Conjunto de funciones exportadas, sin estado (p. ej. retry-policy.ts)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="448" width="800" height="58" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«sql function» api.x()&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Función PL/pgSQL que el backend invoca por RPC (PostgREST)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="510" width="800" height="58" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;«composition root»&lt;/font&gt;&lt;/b&gt;&lt;br&gt;buildApplication() / buildWorker(): único lugar que conoce las implementaciones concretas." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="572" width="800" height="58" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;Diagramas de secuencia&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Mensajes numerados; flecha llena = llamada, discontinua = respuesta; marcos alt / loop según UML 2." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="634" width="800" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p01" name="01 Vista de despliegue"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Vista de despliegue: producción documentada, estado actual y entorno de desarrollo" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1700" height="32" as="geometry"/></mxCell><mxCell id="st" value="Producción: Vercel sirve frontend/ y reescribe /api/* y /health/* hacia Render (mismo origen, sin CORS; ADR-004 §6). La API y el worker son procesos separados (ADR-005). Lo de Vercel y Render no está en el repositorio. Desarrollo: marco discontinuo." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1700" height="40" as="geometry"/></mxCell><mxCell id="vercelc" value="Vercel (borde) · configuración fuera del repositorio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="340" height="340" as="geometry"/></mxCell><mxCell id="renderc" value="Render · procesos separados (ADR-005)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="560" height="340" as="geometry"/></mxCell><mxCell id="supc" value="Supabase (nube)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="340" height="340" as="geometry"/></mxCell><mxCell id="client" value="«client»&lt;br&gt;&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;SPA de frontend/ (login real;&lt;br&gt;resto de vistas en demo)&lt;br&gt;cookies HttpOnly __Host-sal_at y __Host-sal_rt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="160" as="geometry"/></mxCell><mxCell id="spa" value="«artifact»&lt;br&gt;&lt;b&gt;frontend/ (dist)&lt;/b&gt;&lt;br&gt;SPA estática React + Vite" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="300" height="80" as="geometry"/></mxCell><mxCell id="rw" value="Reescribe /api/* y /health/* hacia Render: el navegador y la API comparten origen, por eso SameSite=Lax basta (ADR-004 §6)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="300" height="170" as="geometry"/></mxCell><mxCell id="api" value="«execution environment»&lt;br&gt;&lt;b&gt;api (Express)&lt;/b&gt;&lt;br&gt;backend/src/server.ts → app.ts&lt;br&gt;cadena /api: authenticate → guards → router&lt;br&gt;identidad api_technical (webhook y tokens)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="500" height="110" as="geometry"/></mxCell><mxCell id="worker" value="«process»&lt;br&gt;&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;backend/src/worker.ts → buildWorker() → createWorkerLoop()&lt;br&gt;identidad worker: solo RPC worker_* (outbox y purgas F7)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="310" width="500" height="110" as="geometry"/></mxCell><mxCell id="pg" value="«database»&lt;br&gt;&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;esquema api: único expuesto por PostgREST&lt;br&gt;esquema app: RLS, sin acceso directo&lt;br&gt;app_privileged: funciones DEFINER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="170" width="300" height="110" as="geometry"/></mxCell><mxCell id="auth" value="«service»&lt;br&gt;&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;cuentas, JWT (600 s) y refresh rotativo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="310" width="300" height="110" as="geometry"/></mxCell><mxCell id="resend" value="«external»&lt;br&gt;&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;API de envío (Idempotency-Key) y webhook firmado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="560" height="90" as="geometry"/></mxCell><mxCell id="devc" value="Desarrollo (marco discontinuo; no es evidencia del backend real)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1720" height="400" as="geometry"/></mxCell><mxCell id="vite" value="«artifact»&lt;br&gt;&lt;b&gt;Vite frontend/&lt;/b&gt;&lt;br&gt;127.0.0.1:5174 · proxy /api y /health → :3000" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="380" height="110" as="geometry"/></mxCell><mxCell id="express" value="«execution environment»&lt;br&gt;&lt;b&gt;backend local&lt;/b&gt;&lt;br&gt;Express en :3000 (backend/.env)&lt;br&gt;ALLOWED_ORIGINS incluye http://127.0.0.1:5174" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="700" width="380" height="110" as="geometry"/></mxCell><mxCell id="sbl" value="«device»&lt;br&gt;&lt;b&gt;Supabase local (Docker)&lt;/b&gt;&lt;br&gt;API 54321 · Postgres 54322&lt;br&gt;config: backend/supabase/config.toml" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="380" height="110" as="geometry"/></mxCell><mxCell id="webvite" value="«artifact»&lt;br&gt;&lt;b&gt;apps/web (demo)&lt;/b&gt;&lt;br&gt;Vite 127.0.0.1:5173 · proxy /api → :4011" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="860" width="380" height="110" as="geometry"/></mxCell><mxCell id="mock" value="«execution environment»&lt;br&gt;&lt;b&gt;apps/mock-api&lt;/b&gt;&lt;br&gt;Express en memoria en :4011&lt;br&gt;se niega a iniciar con NODE_ENV=production" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="860" width="380" height="110" as="geometry"/></mxCell><mxCell id="prism" value="«tool»&lt;br&gt;&lt;b&gt;Prism&lt;/b&gt;&lt;br&gt;sirve docs/openapi.json en :4010&lt;br&gt;(contrato; no prueba auth ni RLS)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="860" width="380" height="110" as="geometry"/></mxCell><mxCell id="tools" value="«tools»&lt;br&gt;&lt;b&gt;Pruebas y herramientas&lt;/b&gt;&lt;br&gt;Playwright: apps/web/e2e con 5173 y 4011&lt;br&gt;frontend/: Vitest + jsdom (sin Playwright)&lt;br&gt;Bruno: local.bru → 4011; local-backend.bru → 3000; prism.bru → 4010" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="700" width="340" height="270" as="geometry"/></mxCell><mxCell id="notes" value="Estado actual de la integración: el login real llama a POST /api/v1/auth/sessions y GET /api/v1/auth/csrf-token. El token CSRF se obtiene, pero aún no se envía como X-CSRF-Token porque todavía no hay mutaciones. Donante, hospital y superadmin usan datos demo (lib/demoApi.ts y estado en memoria), sin guards de sesión.&lt;br&gt;Producción no verificada en el repositorio: no hay vercel.json, render.yaml ni Dockerfile; ADR-004 §6 y ADR-005 describen la topología, pendiente de verificar en F9." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="1700" height="100" as="geometry"/></mxCell><mxCell id="e_b_v" value="HTTPS, mismo origen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="vercelc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_v_a" value="rewrite /api/*, /health/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="vercelc" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_p" value="RPC (PostgREST, JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_w_r" value="envío de email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="resend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_vi_ex" value="/api, /health" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="vite" target="express"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ex_sb" value="RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="express" target="sbl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_wv_mk" value="/api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="webvite" target="mock"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p02" name="02 Monolito modular"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Monolito modular: módulos, dependencias de compilación y conexiones de runtime" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1700" height="32" as="geometry"/></mxCell><mxCell id="st" value="Un proceso API (Express) y un proceso worker, del mismo repositorio. Línea discontinua: dependencia de compilación («import type»). Línea continua: conexión que compone composition.ts. Cada módulo tiene domain/, application/, http/ e infrastructure/ (página 03)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1700" height="36" as="geometry"/></mxCell><mxCell id="apic" value="Proceso API · Express · composition.ts (buildApplication)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1220" height="580" as="geometry"/></mxCell><mxCell id="workc" value="Proceso worker · composition-worker.ts (buildWorker) · identidad técnica worker" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=none;dashed=1;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1220" height="200" as="geometry"/></mxCell><mxCell id="donor" value="«module»&lt;br&gt;&lt;b&gt;donor-records&lt;/b&gt;&lt;br&gt;perfil y disponibilidad&lt;br&gt;verificación de correo y altas asistidas&lt;br&gt;cambio de correo y contraseña inicial" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="330" height="110" as="geometry"/></mxCell><mxCell id="ident" value="«module»&lt;br&gt;&lt;b&gt;identity-institutions&lt;/b&gt;&lt;br&gt;login, sesión y CSRF&lt;br&gt;tokens de acción (activación, recuperación)&lt;br&gt;instituciones y administradores" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="330" height="110" as="geometry"/></mxCell><mxCell id="need" value="«module»&lt;br&gt;&lt;b&gt;need-records&lt;/b&gt;&lt;br&gt;borrador de necesidad (RPC atómica)&lt;br&gt;listado, detalle y transiciones&lt;br&gt;no importa otros módulos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="330" height="110" as="geometry"/></mxCell><mxCell id="email" value="«module»&lt;br&gt;&lt;b&gt;email-delivery (API)&lt;/b&gt;&lt;br&gt;sella y encola emails en el outbox&lt;br&gt;ingesta del webhook firmado de Resend" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="330" height="110" as="geometry"/></mxCell><mxCell id="priv" value="«module»&lt;br&gt;&lt;b&gt;privacy-requests&lt;/b&gt; (F7)&lt;br&gt;solicitudes de corrección y eliminación&lt;br&gt;la purga la ejecuta el worker" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="330" height="110" as="geometry"/></mxCell><mxCell id="inv" value="«module» · solo dominio, no montado&lt;br&gt;&lt;b&gt;invitation-coordination&lt;/b&gt; (F6)&lt;br&gt;compatibilidad ABO/Rh y Haversine&lt;br&gt;ranking y lotes de invitación" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="330" height="110" as="geometry"/></mxCell><mxCell id="plat" value="«module»&lt;br&gt;&lt;b&gt;platform&lt;/b&gt;&lt;br&gt;health y readiness de la base" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="330" height="110" as="geometry"/></mxCell><mxCell id="tech" value="«shared»&lt;br&gt;&lt;b&gt;sesión técnica&lt;/b&gt;&lt;br&gt;shared/auth/technical-session.ts&lt;br&gt;identidad api_technical (webhook y tokens)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="460" width="330" height="110" as="geometry"/></mxCell><mxCell id="comp" value="«composition root»&lt;br&gt;&lt;b&gt;composition.ts&lt;/b&gt;&lt;br&gt;buildApplication() (:63): crea adaptadores,&lt;br&gt;inyecta callbacks y monta las rutas" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5f5f2;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="460" width="330" height="110" as="geometry"/></mxCell><mxCell id="shared" value="«shared» · shared/http (guards, CSRF/origen, ApiError) · shared/auth (authenticate, principal) · shared/persistence (RpcInvoker, SupabaseFactory, RpcReply) · shared/crypto (HMAC, cifrado del outbox) · shared/audit (denegaciones)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1150" height="70" as="geometry"/></mxCell><mxCell id="ewk" value="«module»&lt;br&gt;&lt;b&gt;email-delivery (worker)&lt;/b&gt;&lt;br&gt;processor, worker-loop, sender&lt;br&gt;(Resend o Fake), política de reintentos" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="330" height="110" as="geometry"/></mxCell><mxCell id="pwk" value="«module»&lt;br&gt;&lt;b&gt;privacy-requests (purga)&lt;/b&gt;&lt;br&gt;job de purga F7 con RPC worker_*" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1d3557;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="750" width="330" height="110" as="geometry"/></mxCell><mxCell id="cwk" value="«composition root»&lt;br&gt;&lt;b&gt;composition-worker.ts&lt;/b&gt;&lt;br&gt;buildWorker() (:31): sender Resend si&lt;br&gt;provider = resend; si no, Fake" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5f5f2;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="750" width="330" height="110" as="geometry"/></mxCell><mxCell id="fe" value="«artifact»&lt;br&gt;&lt;b&gt;frontend/ SPA React&lt;/b&gt;&lt;br&gt;login real: /api/v1/auth/sessions y /csrf-token&lt;br&gt;resto de vistas en demo (lib/demoApi.ts)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="400" height="100" as="geometry"/></mxCell><mxCell id="resend" value="«external»&lt;br&gt;&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;envío de email y webhook firmado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="300" width="400" height="100" as="geometry"/></mxCell><mxCell id="pg" value="«database»&lt;br&gt;&lt;b&gt;Supabase Postgres&lt;/b&gt;&lt;br&gt;esquemas api (PostgREST) y app, con RLS&lt;br&gt;outbox: app.email_outbox" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="440" width="400" height="100" as="geometry"/></mxCell><mxCell id="sbauth" value="«external»&lt;br&gt;&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;cuentas, JWT y admin API" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="580" width="400" height="80" as="geometry"/></mxCell><mxCell id="notes" value="Dependencias de compilación («import type», 5): donor-records → identity-institutions (AuthAdmin, SealEmail, RateLimiter) · privacy-requests → identity-institutions (SealEmail) · invitation-coordination → need-records (NeedBloodType). need-records no importa otros módulos. No hay ciclos.&lt;br&gt;Conexiones de runtime (composition.ts): onPasswordChanged: identity-institutions → donor-records.confirmPasswordSetup (:98) · eraser: privacy-requests → AuthAdmin.deleteAccount (:121) · seal (sealEmailPayload) de donor-records, identity-institutions y privacy-requests → RPC app.enqueue_email (outbox)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="1700" height="110" as="geometry"/></mxCell><mxCell id="e1" value="import type" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="donor" target="ident"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="import type" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="priv" target="ident"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="import type" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inv" target="need"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="seal → outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="donor" target="email"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="/api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fe" target="apic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="RPC (SQL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shared" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p03" name="03 Arquitectura hexagonal dentro de un módulo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Arquitectura hexagonal dentro de un módulo — need-records&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1640" height="32" as="geometry"/></mxCell><mxCell id="c2" value="El núcleo (aplicación + dominio) no conoce Express ni Supabase. A la izquierda entra la petición (adaptador de entrada) y a la derecha&lt;br&gt;sale hacia la base de datos (adaptador de salida). Toda flecha de dependencia de código apunta hacia el núcleo." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="52" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.14;fillColor=#eef7ec;strokeColor=#82b366;strokeWidth=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="760" height="540" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Núcleo de need-records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;application/ + domain/&lt;/font&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;align=center;" vertex="1" parent="c3"><mxGeometry x="230" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c5" value="«factory» &lt;b&gt;createNeedsService&lt;/b&gt;&lt;br&gt;application/needs-service.ts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;listar, consultar, transicionar&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c3"><mxGeometry x="130" y="120" width="250" height="64" as="geometry"/></mxCell><mxCell id="c6" value="«factory» &lt;b&gt;createNeedDraftService&lt;/b&gt;&lt;br&gt;application/create-need-draft.ts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;crear borrador&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c3"><mxGeometry x="130" y="230" width="250" height="64" as="geometry"/></mxCell><mxCell id="c7" value="«interface» &lt;b&gt;NeedsRepository&lt;/b&gt;&lt;br&gt;application/needs.ports.ts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;puerto de salida&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="c3"><mxGeometry x="500" y="120" width="230" height="64" as="geometry"/></mxCell><mxCell id="c8" value="«interface» &lt;b&gt;AtomicNeedDraftGateway&lt;/b&gt;&lt;br&gt;create-need-draft.ports.ts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;puerto de salida&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="c3"><mxGeometry x="500" y="230" width="230" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;domain/&lt;/b&gt; (puro: sin reloj propio, Express, Supabase ni I/O)&lt;br&gt;need-state.ts: NEED_STATUSES, canTransitionManually, projectStatus, evaluateManualTransition&lt;br&gt;need-draft.ts: createNeedDraft, projectNeedDraft" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c3"><mxGeometry x="210" y="370" width="340" height="110" as="geometry"/></mxCell><mxCell id="c10" value="repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;" edge="1" parent="c3" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;" edge="1" parent="c3" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="createNeedDraft, tipos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c3" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Cliente HTTP&lt;/b&gt;&lt;br&gt;admin hospitalario (navegador)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="250" height="60" as="geometry"/></mxCell><mxCell id="c14" value="«adaptador de entrada» &lt;b&gt;needs.router.ts&lt;/b&gt;&lt;br&gt;registerNeedsRoutes()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;compileOperation + guards; solo parsea, autoriza y serializa&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="250" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;dto/validators.ts&lt;/b&gt;&lt;br&gt;AJV 2020, esquemas generados desde docs/openapi.json" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="c16" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="NeedsService" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArro