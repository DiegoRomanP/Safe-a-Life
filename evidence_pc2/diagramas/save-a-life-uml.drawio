itDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1022" y="520"/><mxPoint x="860" y="520"/><mxPoint x="860" y="602"/></Array></mxGeometry></mxCell><mxCell id="c21" value="[now ≥ expires_at]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="195"/></Array></mxGeometry></mxCell><mxCell id="c22" value="[now ≥ expires_at]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="[now ≥ expires_at]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="195"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Dónde vive la regla&lt;/b&gt;&lt;br&gt;La fuente de verdad es SQL: api.transition_own_need decide la matriz bajo bloqueo de fila.&lt;br&gt;&lt;br&gt;need-state.ts replica la regla (canTransitionManually, evaluateManualTransition, projectStatus); hoy solo la usan las pruebas (punto débil 4.1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="140" width="320" height="230" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;vencida sin cron&lt;/b&gt;: no se escribe con un proceso programado. Al leer, un estado no terminal con now ≥ expires_at se proyecta como vencida (projectStatus / CASE en SQL)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="320" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Estados terminales&lt;/b&gt; (amarillo): cerrada, cancelada y vencida no se reabren. meta_alcanzada solo existe en el CHECK de la tabla: la pondrá el conteo de confirmaciones de invitation-coordination (F6; hoy solo existe su dominio puro)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="16 Transactional outbox + política de reintentos"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1260" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Patrón: transactional outbox + worker que consulta la cola + política de reintentos&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1790" height="32" as="geometry"/></mxCell><mxCell id="c2" value="El productor no llama a Resend: en la MISMA transacción del cambio de negocio inserta el correo cifrado en app.email_outbox. Un worker aparte&lt;br&gt;reclama los mensajes pendientes, envía y registra cada intento. Si el envío falla de forma transitoria, se reprograma con backoff." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1790" height="52" as="geometry"/></mxCell><mxCell id="c3" value="«application · productores»&lt;br&gt;&lt;b&gt;createDonorRecordsService / createActionTokensService&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="427" height="106" as="geometry"/></mxCell><mxCell id="c4" value="- seal(outboxId, payload)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="40" width="427" height="18" as="geometry"/></mxCell><mxCell id="c5" value=