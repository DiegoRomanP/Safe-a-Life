e;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c40" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="c41" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p05" name="05 Persistencia segura"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Persistencia segura — esquemas, roles y funciones (ADR-003, ADR-006)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1590" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Cada comando atómico es una función PL/pgSQL. El cliente (y el backend) solo puede ejecutar funciones del esquema api; las tablas viven en app,&lt;br&gt;que PostgREST no expone. Las funciones son INVOKER por regla; las DEFINER son excepciones cerradas y una prueba pgTAP lo verifica." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1590" height="52" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;anon&lt;/b&gt; (anon key)&lt;br&gt;login, vistas previas por token, readiness" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="330" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;authenticated&lt;/b&gt; (JWT del usuario)&lt;br&gt;donante · admin_hospitalario · superadmin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="235" width="330" height="80" as="geometry"/></mxCell><mxCell id="c5" value="identidad técnica &lt;b&gt;api_technical&lt;/b&gt;&lt;br&gt;(usuario Auth; app.user_accounts.role)&lt;br&gt;webhook firmado, RPC públicas de tokens" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="330" height="80" as="geometry"/></mxCell><mxCell id="c6" value="identidad técnica &lt;b&gt;worker&lt;/b&gt;&lt;br&gt;solo las RPC worker_* (outbox y purgas F7)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="445" width="330" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;service_role&lt;/b&gt;&lt;br&gt;solo Supabase Auth Admin (allowlist ADR-006); nunca operaciones ordinarias" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="330" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;«schema» api&lt;/b&gt; — único esquema expuesto por PostgREST" style="shape=folder;tabWidth=180;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=26;fontSize=12;container=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="470" height="560" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;SECURITY INVOKER&lt;/b&gt; — la regla general&lt;br&gt;se ejecuta con el rol y el JWT de quien llama&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;create_need_draft · list_own_needs&lt;br&gt;get_own_need · transition_own_need · …&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="c8"><mxGeometry x="20" y="60" width="430" height="170" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SECURITY DEFINER&lt;/b&gt; — excepción con allowlist en ADR-003&lt;br&gt;dueño app_privileged (las 7 de auth son de postgres), search_path vacío&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;worker_claim_due_outbox · worker_record_attempt&lt;br&gt;worker_expire_outbox · ingest_email_event&lt;br&gt;consume_rate_limit · readiness · RPC de donantes y tokens&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="c8"><mxGeometry x="20" y="260" width="430" height="180" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;app_privileged&lt;/b&gt;: NOLOGIN, NOBYPASSRLS&lt;br&gt;dueño de las funciones DEFINER de la allowlist" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="c8"><mxGeometry x="20" y="475" width="430" height="60" as="geometry"/></mxCell><mxCell id="c12" value="propietario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;endSize=10;" edge="1" parent="c8" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;«schema» app&lt;/b&gt; — NO expuesto (no está en [api] schemas)" style="shape=folder;tabWidth=180;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=26;fontSize=12;container=1;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="120" width="560" height="560" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Tablas&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;needs · user_accounts · donor_profiles&lt;br&gt;idempotency_records · audit_events · rate_limit_events&lt;br&gt;email_outbox · email_attempts · email_webhook_events · …&lt;/font&gt;&lt;br&gt;&lt;br&gt;audit_events: sin UPDATE ni DELETE (y un trigger lo impide)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="c13"><mxGeometry x="20" y="60" width="520" height="170" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;RLS ENABLE + FORCE&lt;/b&gt; en todas las tablas&lt;br&gt;políticas USING / WITH CHECK por rol, hospital y propietario" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c13"><mxGeometry x="20" y="260" width="520" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Funciones internas&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;write_audit · peek/claim/complete_idempotency&lt;br&gt;enqueue_email · is_worker · is_api_technical · jwt_sub&lt;/font