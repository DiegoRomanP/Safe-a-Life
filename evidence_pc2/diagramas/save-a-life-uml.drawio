t="40" as="geometry"/></mxCell><mxCell id="c34" value="19. recordAttempt(record) → RPC worker_record_attempt" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="327.5" y="963" as="sourcePoint"/><mxPoint x="532.5" y="963" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="20. expire() cada 60 s → RPC worker_expire_outbox" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122.5" y="999" as="sourcePoint"/><mxPoint x="532.5" y="999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;endArrow=none;dashed=1;dashPattern=8 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="1069" as="sourcePoint"/><mxPoint x="1650" y="1069" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;i&gt;más tarde, de forma asíncrona&lt;/i&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;align=center;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="1059" width="400" height="20" as="geometry"/></mxCell><mxCell id="c38" value="21. POST /api/v1/email-delivery/webhooks/resend" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1352.5" y="1119" as="sourcePoint"/><mxPoint x="1557.5" y="1119" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557.5" y="1159" as="sourcePoint"/><mxPoint x="1557.5" y="1201" as="targetPoint"/><Array as="points"><mxPoint x="1585.5" y="1159"/><mxPoint x="1585.5" y="1201"/></Array></mxGeometry></mxCell><mxCell id="c40" value="22. verifyWebhook(secret, cabeceras Svix, rawBody)" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1591.5" y="1155" width="161" height="50" as="geometry"/></mxCell><mxCell id="c41" value="23. ingestEvent(event) → RPC ingest_email_event (identidad api_technical)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557.5" y="1223" as="sourcePoint"/><mxPoint x="532.5" y="1223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="24. 2xx" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endSize=7;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1557.5" y="1259" as="sourcePoint"/><mxPoint x="1352.5" y="1259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fillColor=none;fontSize=11;fontStyle=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="232.5" y="407" width="1215" height="568" as="geometry"/></mxCell><mxCell id="c44" value="[por cada mensaje reclamado]" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="288.5" y="409" width="420" height="18" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Garantías&lt;/b&gt;: el payload viaja cifrado (AAD = outboxId) y se destruye al finalizar; la misma Idempotency-Key en cada reintento evita duplicados en Resend; máximo 6 llamadas; un intento obsoleto (otro worker tomó la fila) no cambia nada." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#fffbe6;strokeColor=#bfa200;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1325" width="1100" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p08" name="10 Puertos y adaptadores + inversión de dependencias + composition root"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="1150" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Patrón: puertos y adaptadores + inversión de dependencias + composition root (need-records)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="2190" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Los casos de uso dependen de interfaces (puertos) que define la propia aplicación. El adaptador RPC las implementa y solo composition.ts conoce&lt;br&gt;las piezas concretas y las conecta. Por eso las pruebas sustituyen el repositorio por un doble sin levantar Supabase." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="2190" height="52" as="geometry"/></mxCell><mxCell id="c3" value="«composition root»&lt;br&gt;&lt;b&gt;buildApplication(config, logger)  —  composition.ts&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#ffffff;fillColor=#d9f2f0;strokeColor=#2b7a78;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2170" height="116" as="geometry"/></mxCell><mxCell id="c4" value="const rpc = createRpcInvoker(createSupabaseFactory(config))" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="40" width="2170" height="18" as="geometry"/></mxCell><mxCell id="c5" value="const needsGateway = createNeedsRpcGateway({ rpc, raw })" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="58" width="2170" height="18" as="geometry"/></mxCell><mxCell id="c6" value="const needs = createNeedsService(needsGateway.repository)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="76" width="2170" height="18" as="geometry"/></mxCell><mxCell id="c7" value="registerNeedsRoutes(app, { needs, createDraft: (t) =&amp;gt; createNeedDraftService(needsGateway.draftGatewayFor(t)), secrets })" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="c3"><mxGeometry x="0" y="94" width="2170" height="18" as="geometry"/></mxCell><mxCell id="c8" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;registerNeedsRoutes(app, deps)&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="