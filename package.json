{
  "name": "save-a-life-prototype",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "workspaces": [
    "apps/mock-api",
    "apps/web",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n mock,web -c cyan,magenta \"npm:dev:mock\" \"npm:dev:web\"",
    "dev:mock": "npm run dev --workspace @save-a-life/mock-api",
    "dev:web": "npm run dev --workspace @save-a-life/web",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace @save-a-life/frontend",
    "mock:prism": "prism mock docs/openapi.json --host 127.0.0.1 --port 4010",
    "openapi:lint": "redocly lint docs/openapi.json",
    "audit:production": "npm audit --omit=dev",
    "openapi:types": "node scripts/generate-api-contract.mjs --write",
    "openapi:api:check": "node scripts/generate-api-contract.mjs --check",
    "test:api:generator": "node --test scripts/generate-api-contract.test.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace @save-a-life/mock-api",
    "test:backend:dto": "npm run test --workspace backend",
    "test:backend:db": "supabase test db --workdir backend",
    "test:backend:integration": "node scripts/test-backend-integration.mjs",
    "test:contract": "node --test scripts/prism-contract.test.mjs && node scripts/test-prism-contract.mjs",
    "test:bruno": "node scripts/test-bruno.mjs",
    "test:bruno:backend": "node --import tsx scripts/test-bruno-backend.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:root",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "node scripts/test-e2e.mjs",
    "dev:worker": "npm run dev:worker --workspace backend",
    "lint:root": "eslint scripts playwright.config.ts eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.57.0",
    "@stoplight/prism-cli": "5.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "protobufjs": false
  }
}
