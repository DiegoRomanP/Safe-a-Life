# Copiar a backend/.env para desarrollo local. Dejar los secretos vacíos aquí.
# Nunca commitear valores reales ni usar la clave service_role.
# Variables por proceso. Worker: SUPABASE_URL, SUPABASE_ANON_KEY, EMAIL_HMAC_SECRET, OUTBOX_KEYS, OUTBOX_KEY_CURRENT,
# WORKER_*, APP_PUBLIC_URL, EMAIL_* (sin RESEND_WEBHOOK_SECRET). API: todo lo demás salvo WORKER_*. Cada proceso ignora
# las variables del otro; no pongas los secretos de la API (CSRF, cursor, borde, service_role) en el entorno del worker.

PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
# Solo para el adaptador allowlisted de Auth Admin (ADR-006). Nunca en otros módulos.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes exactos separados por comas, sin barra final. Vacío = ninguno.
ALLOWED_ORIGINS=
# Proxies de confianza: vacío = ninguno; un entero 1-5 = saltos;
# o IP/CIDR separados por comas (10.0.0.0/8, ::1/128). Confirmar los saltos en staging (ADR-004).
TRUSTED_PROXIES=
# Secreto compartido con el borde de Vercel (cabecera X-Edge-Secret), >=32 caracteres y distinto
# de los demás secretos. Vacío = sin guard (solo desarrollo). Obligatorio con NODE_ENV=production.
EDGE_SHARED_SECRET=

CSRF_SECRET=
EMAIL_HMAC_SECRET=
# >=32 caracteres y distinto de CSRF_SECRET y EMAIL_HMAC_SECRET.
CURSOR_SECRET=
# Keyring del outbox: kid:base64 separados por comas (kid [a-z0-9]{1,16}; cada
# clave son 32 bytes en base64 estándar, 44 caracteres). Para rotar: añadir una
# clave nueva, cambiar OUTBOX_KEY_CURRENT y conservar las anteriores hasta que
# no queden payloads pendientes.
OUTBOX_KEYS=
OUTBOX_KEY_CURRENT=

# Identidad técnica del worker (usuario de Supabase Auth con rol interno worker). Solo el proceso del worker la necesita: no
# la pongas en el entorno de la API.
WORKER_EMAIL=
WORKER_PASSWORD=
# Identidad técnica de la API (usuario de Supabase Auth con rol interno api_technical, distinto del worker). Solo la necesita
# el proceso de la API. En producción la contraseña debe tener al menos 32 caracteres aleatorios.
API_TECHNICAL_EMAIL=
API_TECHNICAL_PASSWORD=
# Entero 1000-60000 (por defecto 5000).
WORKER_POLL_MS=

# Base de los enlaces de los correos: https, o http solo hacia localhost.
APP_PUBLIC_URL=
EMAIL_FROM=

# fake (por defecto) o resend.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
# whsec_<base64>; obligatorio con EMAIL_PROVIDER=resend. En modo fake es opcional y, si se define, habilita el webhook.
RESEND_WEBHOOK_SECRET=
EMAIL_INBOX_ALLOWLIST=
