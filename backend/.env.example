# Copiar a backend/.env para desarrollo local. Dejar los secretos vacíos aquí.
# Nunca commitear valores reales ni usar la clave service_role.

PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=

# Orígenes exactos separados por comas, sin barra final. Vacío = ninguno.
ALLOWED_ORIGINS=
# IPs literales de proxies de confianza separadas por comas. Vacío = ninguno.
TRUSTED_PROXIES=

CSRF_SECRET=
EMAIL_HMAC_SECRET=
# 32 bytes codificados en base64 estándar (44 caracteres).
OUTBOX_KEY=

# fake (por defecto) o resend.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_INBOX_ALLOWLIST=
