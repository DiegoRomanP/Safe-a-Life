        "activa",
        "meta_alcanzada",
        "cerrada",
        "cancelada",
        "vencida"
      ],
      "description": "meta_alcanzada y vencida son estados calculados por el sistema; cerrada/cancelada/vencida son terminales."
    },
    "Urgency": {
      "type": "string",
      "enum": [
