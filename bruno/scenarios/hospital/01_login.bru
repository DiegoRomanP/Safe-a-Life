meta {
  name: Hospital login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "email": "{{hospitalEmail}}",
    "password": "{{demoPassword}}"
  }
}

tests {
  test("login binds a synthetic hospital actor", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.actor.role).to.equal("admin_hospitalario");
    expect(res.getBody().data.actor.hospitalName).to.equal("Hospital Demo");
  });
}
