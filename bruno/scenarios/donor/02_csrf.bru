meta {
  name: Donor CSRF token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/csrf-token
  body: none
  auth: inherit
}

tests {
  test("CSRF token is available only in the authenticated session", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.token.length).to.be.at.least(32);
    bru.setVar("csrfToken", res.getBody().data.token);
  });
}
