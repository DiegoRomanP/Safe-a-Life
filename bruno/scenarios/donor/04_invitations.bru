meta {
  name: Donor own invitations
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/donors/me/invitations
  body: none
  auth: inherit
}

tests {
  test("invitations are own, minimal, and do not expose action secrets", function () {
    const body = res.getBody().data;
    expect(res.getStatus()).to.equal(200);
    expect(body.items).to.have.length(1);
    expect(body.items[0].hospitalName).to.equal("Hospital Demo");
    expect(body.items[0]).to.not.have.property("actionToken");
    expect(body.items[0]).to.not.have.property("donorId");
    expect(body.items[0]).to.not.have.property("latitude");
  });
}
