meta {
  name: Consulta información mínima del enlace de acción
  type: http
  seq: 1
  tags: [
    Invitation_action
  ]
}

get {
  url: {{baseUrl}}/api/v1/invitation-actions/:token
  body: none
  auth: inherit
}

params:path {
  @description('Secreto de acción de un solo uso, ligado a invitación y acción. Nunca incluir valores reales en documentación, logs o ejemplos.')
  token:
}

docs {
  Lectura informativa: nunca consume el token ni cambia estado. No cachear, cargar terceros, registrar el token ni registrar la URL completa (RF-INV-03, RNF-SEC-13).
}

example {
  name: 200 Response
  description: Vista previa mínima del enlace.

  request: {
    url: {{baseUrl}}/api/v1/invitation-actions/:token
    method: GET
    mode: none
    params:path: {
      token:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "hospitalName": "Hospital Demo",
            "publicSiteName": "Sede Centro",
            "intendedAction": "confirmar",
            "expiresAt": "2026-10-02T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/invitation-actions/:token
    method: GET
    mode: none
    params:path: {
      token:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}

example {
  name: 410 Response
  description: Token de acción vencido o consumido.

  request: {
    url: {{baseUrl}}/api/v1/invitation-actions/:token
    method: GET
    mode: none
    params:path: {
      token:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 410
      text: Gone
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACTION_UNAVAILABLE",
            "message": "El enlace no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000410"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/invitation-actions/:token
    method: GET
    mode: none
    params:path: {
      token:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
