meta {
  name: Retira la oferta pública
  type: http
  seq: 14
  tags: [
    Hospital
  ]
}

delete {
  url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
  body: none
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

example {
  name: 204 Response
  description: Oferta retirada; conserva auditoría/versionado.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: DELETE
    mode: none
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    status: {
      code: 204
      text: No Content
    }

    body: {
      type: text
      content: '''

      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: DELETE
    mode: none
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: DELETE
    mode: none
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: DELETE
    mode: none
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "STATE_CONFLICT",
            "message": "La operación entra en conflicto con el estado actual.",
            "correlationId": "00000000-0000-4000-8000-000000000409"
          }
        }
      '''
    }
  }
}
