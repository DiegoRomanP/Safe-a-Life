meta {
  name: Consulta la política de reconocimiento de la institución actual
  type: http
  seq: 12
  tags: [
    Hospital
  ]
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Política propia, incluso cuando no se publica ninguna oferta.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "hospitalName": "Hospital Demo",
            "status": "publicada",
            "offeredItems": [
              "refrigerio",
              "diploma"
            ],
            "version": 2,
            "updatedAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}
