meta {
  name: Solicita una transición permitida de necesidad
  type: http
  seq: 4
  tags: [
    Hospital
  ]
}

patch {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
  body: json
  auth: inherit
}

params:path {
  @description('UUID de necesidad; la autorización también verifica hospital propietario.')
  needId: 4c117ef2-3ebd-43f2-8629-c06d5c8df68f
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "status": "activa"
  }
}

docs {
  Solo admite las transiciones manuales aprobadas. meta_alcanzada y vencida son estados calculados, no valores asignables por el cliente. Las terminales no se reabren (RF-NEC-06 a RF-NEC-08).
}

example {
  name: 200 Response
  description: Transición aplicada.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: PATCH
    mode: json
    params:path: {
      needId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "status": "activa"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "needId": "4c117ef2-3ebd-43f2-8629-c06d5c8df68f",
            "component": "RBC",
            "requiredBloodType": "O_POS",
            "targetConfirmations": 5,
            "confirmedIntentCount": 2,
            "siteId": "1d1258c3-b8ab-4cc6-9120-27df68452261",
            "radiusKm": 10,
            "urgency": "Urgente",
            "status": "activa",
            "expiresAt": "2026-10-02T18:00:00Z"
          }
        }
      '''
    }
  }
}

