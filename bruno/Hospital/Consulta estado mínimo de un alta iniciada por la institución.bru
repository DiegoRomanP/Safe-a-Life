meta {
  name: Consulta estado mínimo de un alta iniciada por la institución
  type: http
  seq: 10
  tags: [
    Hospital
  ]
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId
  body: none
  auth: inherit
}

params:path {
  signupId: 5e5abebf-64ab-4ac4-a276-d91ca386886f
}

example {
  name: 200 Response
  description: Estado/fechas mínimas de la solicitud propia.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId
    method: GET
    mode: none
    params:path: {
      signupId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "signupId": "5e5abebf-64ab-4ac4-a276-d91ca386886f",
            "status": "pendiente",
            "createdAt": "2026-10-01T18:00:00Z",
            "activationExpiresAt": "2026-10-02T18:00:00Z",
            "purgeAt": "2026-10-31T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId
    method: GET
    mode: none
    params:path: {
      signupId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId
    method: GET
    mode: none
    params:path: {
      signupId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId
    method: GET
    mode: none
    params:path: {
      signupId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}
