meta {
  name: Consulta una necesidad propia
  type: http
  seq: 3
  tags: [
    Hospital
  ]
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
  body: none
  auth: inherit
}

params:path {
  @description('UUID de necesidad; la autorización también verifica hospital propietario.')
  needId: 4c117ef2-3ebd-43f2-8629-c06d5c8df68f
}

example {
  name: 200 Response
  description: Necesidad de la institución autenticada.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: GET
    mode: none
    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "needId": "4c117ef2-3ebd-43f2-8629-c06d5c8df68f",
            "component": "RBC",
            "requiredBloodType": "O_POS",
            "targetConfirmations": 5,
            "confirmedIntentCount": 2,
            "siteId": "1d1258c3-b8ab-4cc6-9120-27df68452261",
            "radiusKm": 10,
            "urgency": "Urgente",
            "status": "activa",
            "expiresAt": "2026-10-02T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: GET
    mode: none
    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: GET
    mode: none
    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: GET
    mode: none
    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId
    method: GET
    mode: none
    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
