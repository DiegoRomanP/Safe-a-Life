meta {
  name: Reemite enlace antes de la purga original
  type: http
  seq: 11
  tags: [
    Hospital
  ]
}

post {
  url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId/activation-links
  body: none
  auth: inherit
}

params:path {
  signupId: 5e5abebf-64ab-4ac4-a276-d91ca386886f
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

docs {
  Token de 24 h; reemitir invalida tokens anteriores, retorna estado a pendiente y no reinicia createdAt/purgeAt (AP-01). Respuesta no enumerable.
}

example {
  name: 202 Response
  description: Solicitud de reemisión aceptada de forma neutra.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId/activation-links
    method: POST
    mode: none
    params:path: {
      signupId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 202
      text: Accepted
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Si la solicitud puede procesarse, recibirás instrucciones."
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups/:signupId/activation-links
    method: POST
    mode: none
    params:path: {
      signupId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

