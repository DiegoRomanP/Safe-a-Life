meta {
  name: Consulta conteos y respuestas permitidas de una necesidad propia
  type: http
  seq: 7
  tags: [
    Hospital
  ]
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
  body: none
  auth: inherit
}

params:query {
  @description('Límite por página propuesto; el máximo debe aplicarse también en servidor.')
  limit: 20
  @description('Cursor opaco devuelto por la página anterior; no contiene PII.')
  ~cursor:
}

params:path {
  @description('UUID de necesidad; la autorización también verifica hospital propietario.')
  needId: 4c117ef2-3ebd-43f2-8629-c06d5c8df68f
}

docs {
  Los registros no confirmados y rechazados usan código y estados opacos. Solo una confirmación afirmativa vigente incluye nombre, grupo declarado, respuesta y hora. Si el donante cambia confirmada a rechazada, esta proyección oculta inmediatamente nombre y grupo.
}

example {
  name: 200 Response
  description: Conteos y página minimizada para la necesidad propia.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }

    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "confirmedIntentCount": 1,
            "items": [
              {
                "needDonorCode": "donor-code-51a8f2",
                "validity": "activa",
                "delivery": "entregada",
                "response": "sin_respuesta"
              },
              {
                "needDonorCode": "donor-code-b32d17",
                "donorName": "Donante Demo",
                "declaredBloodType": "O_POS",
                "response": "confirmada",
                "responseRecordedAt": "2026-10-01T18:20:00Z"
              }
            ],
            "pagination": {
              "nextCursor": null
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }

    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }

    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }

    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }

    params:path: {
      needId:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
