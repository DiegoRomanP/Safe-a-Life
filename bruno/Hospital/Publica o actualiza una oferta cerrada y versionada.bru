meta {
  name: Publica o actualiza una oferta cerrada y versionada
  type: http
  seq: 13
  tags: [
    Hospital
  ]
}

put {
  url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "expectedVersion": 2,
    "offeredItems": [
      "refrigerio",
      "diploma"
    ]
  }
}

docs {
  Solo admite refrigerio, diploma y pin. La lista vacía retira la oferta; reconocimiento nunca afecta matching ni respuestas. Usar expectedVersion para conflicto optimista.
}

example {
  name: 200 Response
  description: Política versionada.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "expectedVersion": 2,
        "offeredItems": [
          "refrigerio",
          "diploma"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "hospitalName": "Hospital Demo",
            "status": "publicada",
            "offeredItems": [
              "refrigerio",
              "diploma"
            ],
            "version": 2,
            "updatedAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "expectedVersion": 2,
        "offeredItems": [
          "refrigerio",
          "diploma"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "expectedVersion": 2,
        "offeredItems": [
          "refrigerio",
          "diploma"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "expectedVersion": 2,
        "offeredItems": [
          "refrigerio",
          "diploma"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "STATE_CONFLICT",
            "message": "La operación entra en conflicto con el estado actual.",
            "correlationId": "00000000-0000-4000-8000-000000000409"
          }
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/recognition-policy
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "expectedVersion": 2,
        "offeredItems": [
          "refrigerio",
          "diploma"
        ]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Uno o más valores no cumplen las reglas del campo.",
            "correlationId": "00000000-0000-4000-8000-000000000422"
          }
        }
      '''
    }
  }
}
