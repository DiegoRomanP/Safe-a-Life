meta {
  name: Lista altas asistidas iniciadas por el hospital actual
  type: http
  seq: 8
  tags: [
    Hospital
  ]
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
  body: none
  auth: inherit
}

params:query {
  @description('Límite por página propuesto; el máximo debe aplicarse también en servidor.')
  limit: 20
  @description('Cursor opaco devuelto por la página anterior; no contiene PII.')
  ~cursor:
}

example {
  name: 200 Response
  description: Estados operativos mínimos, sin enumerar cuentas externas.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "items": [
              {
                "signupId": "5e5abebf-64ab-4ac4-a276-d91ca386886f",
                "status": "pendiente",
                "createdAt": "2026-10-01T18:00:00Z",
                "activationExpiresAt": "2026-10-02T18:00:00Z",
                "purgeAt": "2026-10-31T18:00:00Z"
              }
            ],
            "pagination": {
              "nextCursor": null
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
