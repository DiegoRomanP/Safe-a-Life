meta {
  name: Solicita manualmente un lote de invitaciones
  type: http
  seq: 6
  tags: [
    Hospital
  ]
}

post {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/invitation-batches
  body: none
  auth: inherit
}

params:path {
  @description('UUID de necesidad; la autorización también verifica hospital propietario.')
  needId: 4c117ef2-3ebd-43f2-8629-c06d5c8df68f
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

docs {
  El hospital solicita el lote, pero no elige donantes individuales. El servidor aplica los filtros documentados de preselección académica para RBC, radio, orden y cuotas; no determina elegibilidad médica. Invitaciones, outbox y auditoría se confirman en una transacción. No se devuelve identidad de candidatos (RF-MAT/RF-BAT).
}

example {
  name: 201 Response
  description: Lote registrado; puede crear cero invitaciones si no hay candidatos que superen los filtros.

  request: {
    url: {{baseUrl}}/api/v1/hospitals/me/needs/:needId/invitation-batches
    method: POST
    mode: none
    params:path: {
      needId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "batchId": "e2eaec30-1f23-40c7-b986-21395b46a531",
            "createdInvitationCount": 8,
            "queuedEmailCount": 8
          }
        }
      '''
    }
  }
}

