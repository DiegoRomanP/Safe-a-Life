meta {
  name: Replay de la decisión
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/correction-requests/{{privacyRequestId}}
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-decide
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {"decision":"aprobada","reason":"Solicitud sintética verificada."}
}

tests {
  test("devuelve lo guardado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("aprobada");
  });
}
