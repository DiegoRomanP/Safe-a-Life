meta {
  name: Login superadmin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {"email":"{{superadminEmail}}","password":"{{demoPassword}}"}
}

tests {
  test("el login exige MFA", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.mfaRequired).to.equal(true);
    bru.setVar("mfaChallengeId", res.getBody().data.mfaChallengeId);
  });
}
