meta {
  name: El token no se reutiliza
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/assisted-activation-actions/{{claimToken}}/claim
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}-claim-again
}

body:json {
  { "password": "{{donorPassword}}" }
}

tests {
  test("el segundo reclamo es 410", function () {
    expect(res.getStatus()).to.equal(410);
  });
}
