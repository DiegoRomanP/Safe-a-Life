meta {
  name: El perfil no se completa con la contraseña pendiente
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-pend
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  { "name": "Donante Bruno", "declaredBloodType": "O_POS", "isAvailable": true, "approximateLocation": { "latitude": -12.046, "longitude": -77.043 } }
}

tests {
  test("responde 409 hasta que el dueño del buzón fije su contraseña", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error.code).to.equal("STATE_CONFLICT");
  });
}
