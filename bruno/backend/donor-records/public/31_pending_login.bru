meta {
  name: Login de la cuenta pendiente de fijar contraseña
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  { "email": "{{verifyEmail}}", "password": "{{donorPassword}}" }
}

tests {
  test("con la contraseña con la que se registró NO puede iniciar sesión (ADR-007: la barrera sigue abierta hasta el reset)", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("AUTHENTICATION_REQUIRED");
  });
}
