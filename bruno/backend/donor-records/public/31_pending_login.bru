meta {
  name: Login de la cuenta recién verificada
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  { "email": "{{verifyEmail}}", "password": "{{donorPassword}}" }
}

tests {
  test("con la contraseña con la que se registró puede iniciar sesión (aún no es suya)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.mfaRequired).to.equal(false);
    expect(res.getBody().data.actor.role).to.equal("donante");
  });
}
