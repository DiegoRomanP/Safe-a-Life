meta {
  name: Sin CSRF
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/hospitals/me/assisted-signups
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-signup-nocsrf
}

body:json {
  { "email": "nocsrf-{{signupEmail}}" }
}

tests {
  test("sin Origin ni token CSRF es 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
