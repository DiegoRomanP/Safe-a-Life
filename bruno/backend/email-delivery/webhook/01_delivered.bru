meta {
  name: Evento delivered con firma válida
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/email-delivery/webhooks/resend
  body: text
  auth: none
}

headers {
  Content-Type: application/json
  svix-id: {{svixId}}
  svix-timestamp: {{svixTimestamp}}
  svix-signature: {{sigDelivered}}
}

body:text {
  {"type":"email.delivered","created_at":"2026-10-13T12:00:00.000Z","data":{"email_id":"prov-bruno-0001"}}
}

tests {
  test("responde 204 sin cuerpo", function () {
    expect(res.getStatus()).to.equal(204);
    expect(JSON.stringify(res.getBody() || "")).to.not.contain("prov-bruno");
  });
}
