meta {
  name: Marca de tiempo antigua
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/email-delivery/webhooks/resend
  body: text
  auth: none
}

headers {
  Content-Type: application/json
  svix-id: {{svixIdOld}}
  svix-timestamp: {{svixOldTimestamp}}
  svix-signature: {{sigOld}}
}

body:text {
  {"type":"email.delivered","created_at":"2026-10-13T12:00:00.000Z","data":{"email_id":"prov-bruno-0001"}}
}

tests {
  test("una firma correcta pero de hace más de 300 s es 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
