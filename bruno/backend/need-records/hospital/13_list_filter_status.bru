meta {
  name: Filtra por estado proyectado
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/needs?status=borrador&limit=1
  body: none
  auth: inherit
}

tests {
  test("devuelve solo borradores y respeta limit", function () {
    expect(res.getStatus()).to.equal(200);
    var items = res.getBody().data.items;
    expect(items.length).to.equal(1);
    expect(items[0].status).to.equal("borrador");
  });
}
