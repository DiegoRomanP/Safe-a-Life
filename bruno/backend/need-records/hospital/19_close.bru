meta {
  name: Cierra la necesidad
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/{{createdNeedId}}
  body: json
  auth: inherit
}

headers {
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
  Idempotency-Key: {{idempotencyKey}}-close
}

body:json {
  { "status": "cerrada" }
}

tests {
  test("activa → cerrada", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("cerrada");
  });
}
