meta {
  name: Replay de revocar membresía
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/memberships/{{membershipId}}
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-revoke
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "status": "revocada",
    "reason": "Baja de prueba Bruno"
  }
}

tests {
  test("el replay con la misma clave devuelve el mismo resultado, no 409", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("revocada");
  });
}
