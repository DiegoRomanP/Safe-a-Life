meta {
  name: Auditoría
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/superadmin/audit-events?limit=5
  body: none
  auth: inherit
}

tests {
  test("la auditoría registra la creación sin PII", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.items.length).to.be.at.least(1);
    expect(JSON.stringify(res.getBody())).to.not.match(/@|password|token/i);
  });
}
