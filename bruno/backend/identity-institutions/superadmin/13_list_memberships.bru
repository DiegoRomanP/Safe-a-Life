meta {
  name: Membresías
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/superadmin/memberships?limit=100
  body: none
  auth: inherit
}

tests {
  test("lista membresías con pista de email enmascarada", function () {
    expect(res.getStatus()).to.equal(200);
    var target = res.getBody().data.items.find(function (m) { return m.hospitalId === "11111111-1111-4111-8111-111111111103"; });
    expect(target.emailHint).to.match(/^a\*\*\*@example\.test$/);
    bru.setVar("membershipId", target.membershipId);
  });
}
