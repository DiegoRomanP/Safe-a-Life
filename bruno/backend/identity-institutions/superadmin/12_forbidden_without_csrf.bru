meta {
  name: Mutación sin CSRF
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/superadmin/hospitals
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
  Origin: {{appOrigin}}
}

body:json {
  {
    "publicName": "Sin CSRF",
    "legalName": "Sin CSRF S.A."
  }
}

tests {
  test("sin X-CSRF-Token responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
