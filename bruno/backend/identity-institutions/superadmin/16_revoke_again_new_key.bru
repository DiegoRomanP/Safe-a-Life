meta {
  name: Revocar otra vez con otra clave
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/memberships/{{membershipId}}
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-revoke-otra
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "status": "revocada",
    "reason": "Baja de prueba Bruno"
  }
}

tests {
  test("una membresía ya revocada con otra clave es STATE_CONFLICT", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error.code).to.equal("STATE_CONFLICT");
  });
}
