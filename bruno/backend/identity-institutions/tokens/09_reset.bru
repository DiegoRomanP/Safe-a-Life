meta {
  name: Completar el reset
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset-actions/{{resetToken}}
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}-reset
}

body:json {
  { "newPassword": "{{newPassword}}" }
}

tests {
  test("cambia la contraseña y devuelve un mensaje neutro", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Object.keys(res.getBody().data)).to.deep.equal(["message"]);
  });
}
