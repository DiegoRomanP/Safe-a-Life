meta {
  name: Recuperación de un correo inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/password-recovery-requests
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{idempotencyKey}}-rec-2
}

body:json {
  { "email": "no-existe-bruno@example.test" }
}

tests {
  test("responde exactamente lo mismo que para una cuenta existente", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().data.message).to.equal(bru.getVar("neutralMessage"));
  });
}
