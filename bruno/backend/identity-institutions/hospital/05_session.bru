meta {
  name: Sesión del admin hospitalario
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/auth/session
  body: none
  auth: inherit
}

tests {
  test("la sesión es de admin hospitalario con su hospital", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.actor.role).to.equal("admin_hospitalario");
    expect(res.getBody().data.actor.hospitalName).to.equal("Hospital Demo Uno");
  });
}
