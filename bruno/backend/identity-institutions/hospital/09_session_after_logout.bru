meta {
  name: Sesión tras logout
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/auth/session
  body: none
  auth: inherit
}

tests {
  test("la sesión cerrada responde 401", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("AUTHENTICATION_REQUIRED");
  });
}
