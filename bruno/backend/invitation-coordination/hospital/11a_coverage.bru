meta {
  name: La cobertura de una necesidad activa solo trae agregados
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/hospitals/me/needs/{{needId}}/coverage
  body: none
  auth: inherit
}

tests {
  test("200 con forma cerrada, sin ids ni posiciones individuales", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("cache-control")).to.equal("no-store");
    var d = res.getBody().data;
    expect(Object.keys(d).sort()).to.deep.equal(["cells", "compatibleCount", "nextBatchCount", "radiusKm", "rings", "site"]);
    expect(Object.keys(d.site).sort()).to.deep.equal(["latitude", "longitude"]);
  });
  test("grupos de anillos y celdas en cubos (0, 5, 10, 25) con al menos 5 donantes", function () {
    var d = res.getBody().data;
    expect(d.rings.length).to.be.within(1, 4);
    var buckets = [0, 5, 10, 25];
    d.rings.forEach(function (r) {
      expect(Object.keys(r).sort()).to.deep.equal(["count", "fromKm", "toKm"]);
      // k = 5 y cubos: nunca una cifra exacta ni 1 a 4 (null = menos de 5).
      if (r.count === null) { expect(d.compatibleCount).to.equal(null); } else { expect(buckets).to.include(r.count); }
    });
    if (d.compatibleCount !== null) { expect(buckets).to.include(d.compatibleCount); }
    d.cells.forEach(function (c) {
      expect(Object.keys(c).sort()).to.deep.equal(["count", "latitude", "longitude"]);
      expect([5, 10, 25]).to.include(c.count);
    });
    if (d.nextBatchCount !== null) { expect(buckets).to.include(d.nextBatchCount); }
  });
}
