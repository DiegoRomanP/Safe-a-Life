meta {
  name: Cambiar la respuesta exige CSRF
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/donors/me/invitations/{{invitationId}}/response
  body: json
  auth: inherit
}

headers {
  Origin: {{appOrigin}}
  Idempotency-Key: {{idempotencyKey}}-change-nocsrf
}

body:json {
  { "response": "rechazada" }
}

tests {
  test("responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
