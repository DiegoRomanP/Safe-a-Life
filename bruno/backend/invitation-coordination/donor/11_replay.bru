meta {
  name: La misma clave repite el resultado
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/invitation-actions/{{confirmToken}}/response
  body: none
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}-respond
}

tests {
  test("replay 200 con la misma marca de tiempo", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.recordedAt).to.equal(bru.getVar("recordedAt"));
  });
}
