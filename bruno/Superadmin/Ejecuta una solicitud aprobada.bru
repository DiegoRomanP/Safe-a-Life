meta {
  name: Ejecuta una solicitud aprobada
  type: http
  seq: 16
  tags: [
    Superadmin
  ]
}

post {
  url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId/executions
  body: none
  auth: inherit
}

params:path {
  requestId: b30c64a0-488c-4a10-8df5-7411ecb44cc8
}

headers {
  @description('Grant temporal y de alcance específico; nunca se registra en logs.')
  X-Contextual-Grant:
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

docs {
  AAL2, step-up reciente, grant contextual y solicitud aprobada obligatorios. Efecto idempotente y auditado.
}

example {
  name: 200 Response
  description: Ejecución registrada.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId/executions
    method: POST
    mode: none
    params:path: {
      requestId:
    }

    headers: {
      X-Contextual-Grant:
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "requestId": "b30c64a0-488c-4a10-8df5-7411ecb44cc8",
            "type": "correccion",
            "requestedFields": [
              "name"
            ],
            "status": "pendiente",
            "createdAt": "2026-10-01T18:00:00Z",
            "updatedAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId/executions
    method: POST
    mode: none
    params:path: {
      requestId:
    }

    headers: {
      X-Contextual-Grant:
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId/executions
    method: POST
    mode: none
    params:path: {
      requestId:
    }

    headers: {
      X-Contextual-Grant:
      Idempotency-Key:
      session: {{apiKey}}
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

