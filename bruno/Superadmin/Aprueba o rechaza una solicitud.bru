example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
    method: PATCH
    mode: json
    params:path: {
      requestId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "decision": "aprobada",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Uno o más valores no cumplen las reglas del campo.",
            "correlationId": "00000000-0000-4000-8000-000000000422"
          }
        }
      '''
    }
  }
}
