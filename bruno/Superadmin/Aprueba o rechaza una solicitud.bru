meta {
  name: Aprueba o rechaza una solicitud
  type: http
  seq: 14
  tags: [
    Superadmin
  ]
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
  body: json
  auth: inherit
}

params:path {
  requestId: b30c64a0-488c-4a10-8df5-7411ecb44cc8
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "decision": "aprobada",
    "reason": "Solicitud sintética verificada para el ejemplo."
  }
}

example {
  name: 200 Response
  description: Decisión auditada.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
    method: PATCH
    mode: json
    params:path: {
      requestId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "decision": "aprobada",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "requestId": "b30c64a0-488c-4a10-8df5-7411ecb44cc8",
            "type": "correccion",
            "requestedFields": [
              "name"
            ],
            "status": "pendiente",
            "createdAt": "2026-10-01T18:00:00Z",
            "updatedAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
    method: PATCH
    mode: json
    params:path: {
      requestId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "decision": "aprobada",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
    method: PATCH
    mode: json
    params:path: {
      requestId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "decision": "aprobada",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests/:requestId
    method: PATCH
    mode: json
    params:path: {
      requestId:
    }

    headers: {
