meta {
  name: Suspende o levanta suspensión con motivo auditable
  type: http
  seq: 22
  tags: [
    Superadmin
  ]
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/recognition-policies/:hospitalId/moderation
  body: json
  auth: inherit
}

params:path {
  hospitalId: a8b51767-5c30-41fb-bf7a-f90250f9649c
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "status": "suspendida",
    "reason": "Revisión sintética para el ejemplo.",
    "expectedVersion": 2
  }
}

example {
  name: 200 Response
  description: Moderación aplicada y auditada.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/recognition-policies/:hospitalId/moderation
    method: PATCH
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "status": "suspendida",
        "reason": "",
        "expectedVersion": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "hospitalName": "Hospital Demo",
            "status": "publicada",
            "offeredItems": [
              "refrigerio",
              "diploma"
            ],
            "version": 2,
            "updatedAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/recognition-policies/:hospitalId/moderation
    method: PATCH
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "status": "suspendida",
        "reason": "",
        "expectedVersion": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

