meta {
  name: Crea hospital autorizado
  type: http
  seq: 3
  tags: [
    Superadmin
  ]
}

post {
  url: {{baseUrl}}/api/v1/superadmin/hospitals
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "publicName": "Hospital Demo",
    "legalName": "Hospital Académico Demo"
  }
}

docs {
  Solo superadmin; no existe autorregistro hospitalario.
}

example {
  name: 201 Response
  description: Hospital creado.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "legalName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "publicName": "Hospital Demo",
            "legalName": "Hospital Académico Demo",
            "isAuthorized": true,
            "createdAt": "2026-10-01T18:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "legalName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "legalName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "legalName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "STATE_CONFLICT",
            "message": "La operación entra en conflicto con el estado actual.",
            "correlationId": "00000000-0000-4000-8000-000000000409"
          }
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "legalName": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Uno o más valores no cumplen las reglas del campo.",
            "correlationId": "00000000-0000-4000-8000-000000000422"
          }
        }
      '''
    }
  }
}
