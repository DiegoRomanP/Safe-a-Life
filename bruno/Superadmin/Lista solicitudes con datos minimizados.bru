meta {
  name: Lista solicitudes con datos minimizados
  type: http
  seq: 12
  tags: [
    Superadmin
  ]
}

get {
  url: {{baseUrl}}/api/v1/superadmin/correction-requests
  body: none
  auth: inherit
}

params:query {
  @description('Límite por página propuesto; el máximo debe aplicarse también en servidor.')
  limit: 20
  @description('Cursor opaco devuelto por la página anterior; no contiene PII.')
  ~cursor:
}

example {
  name: 200 Response
  description: Solicitudes opacas; sin valores PII previos/nuevos.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "items": [
              {
                "requestId": "b30c64a0-488c-4a10-8df5-7411ecb44cc8",
                "type": "correccion",
                "requestedFields": [
                  "name"
                ],
                "status": "pendiente",
                "createdAt": "2026-10-01T18:00:00Z",
                "updatedAt": "2026-10-01T18:00:00Z"
              }
            ],
            "pagination": {
              "nextCursor": null
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/correction-requests
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}
