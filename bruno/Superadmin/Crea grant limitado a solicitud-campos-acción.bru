meta {
  name: Crea grant limitado a solicitud/campos/acción
  type: http
  seq: 17
  tags: [
    Superadmin
  ]
}

post {
  url: {{baseUrl}}/api/v1/superadmin/access-grants
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "requestId": "b30c64a0-488c-4a10-8df5-7411ecb44cc8",
    "action": "review",
    "allowedFields": [
      "name"
    ],
    "reason": "Revisión sintética de ejemplo."
  }
}

docs {
  Requiere AAL2 y step-up de hasta 5 min. El grant expira en máximo 10 min; registrar motivo y auditoría minimizada.
}

example {
  name: 201 Response
  description: Grant contextual emitido.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/access-grants
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "requestId": "",
        "action": "review",
        "allowedFields": [
          "name"
        ],
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "grantId": "db13a2e5-49d8-408d-89b7-2677a86b2ac9",
            "requestId": "b30c64a0-488c-4a10-8df5-7411ecb44cc8",
            "action": "review",
            "allowedFields": [
              "name",
              "declaredBloodType"
            ],
            "expiresAt": "2026-10-01T18:10:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/access-grants
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "requestId": "",
        "action": "review",
        "allowedFields": [
          "name"
        ],
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/access-grants
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "requestId": "",
        "action": "review",
        "allowedFields": [
          "name"
        ],
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/access-grants
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "requestId": "",
        "action": "review",
        "allowedFields": [
          "name"
        ],
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/access-grants
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "requestId": "",
        "action": "review",
        "allowedFields": [
          "name"
        ],
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Uno o más valores no cumplen las reglas del campo.",
            "correlationId": "00000000-0000-4000-8000-000000000422"
          }
        }
      '''
    }
  }
}
