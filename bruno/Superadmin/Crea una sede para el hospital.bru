example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals/:hospitalId/sites
    method: POST
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
