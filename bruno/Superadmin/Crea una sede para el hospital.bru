  name: 403 Response
  description: Actor autenticado sin permiso; no revelar datos del recurso ajeno.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals/:hospitalId/sites
    method: POST
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "publicAddress": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACCESS_DENIED",
            "message": "La acción no está permitida.",
            "correlationId": "00000000-0000-4000-8000-000000000403"
          }
        }
      '''
    }
  }
}

