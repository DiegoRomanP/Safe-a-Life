meta {
  name: Crea una sede para el hospital
  type: http
  seq: 7
  tags: [
    Superadmin
  ]
}

post {
  url: {{baseUrl}}/api/v1/superadmin/hospitals/:hospitalId/sites
  body: json
  auth: inherit
}

params:path {
  hospitalId: a8b51767-5c30-41fb-bf7a-f90250f9649c
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "publicName": "Sede Centro Demo",
    "publicAddress": "Lima Metropolitana"
  }
}

example {
  name: 201 Response
  description: Sede creada.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals/:hospitalId/sites
    method: POST
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "publicAddress": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "siteId": "1d1258c3-b8ab-4cc6-9120-27df68452261",
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "publicName": "Sede Centro",
            "publicAddress": "Lima Metropolitana",
            "isActive": true,
            "isApproved": true
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/hospitals/:hospitalId/sites
    method: POST
    mode: json
    params:path: {
      hospitalId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "publicName": "",
        "publicAddress": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

