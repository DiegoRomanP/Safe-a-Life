meta {
  name: Revoca membresía hospitalaria
  type: http
  seq: 11
  tags: [
    Superadmin
  ]
}

patch {
  url: {{baseUrl}}/api/v1/superadmin/memberships/:membershipId
  body: json
  auth: inherit
}

params:path {
  membershipId: 95ccf96b-c1f0-4612-8fa2-4480804303d9
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "status": "revocada",
    "reason": "Baja sintética para ejemplo."
  }
}

example {
  name: 200 Response
  description: Membresía revocada y auditada.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/memberships/:membershipId
    method: PATCH
    mode: json
    params:path: {
      membershipId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "status": "",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "membershipId": "95ccf96b-c1f0-4612-8fa2-4480804303d9",
            "hospitalId": "a8b51767-5c30-41fb-bf7a-f90250f9649c",
            "role": "admin_hospitalario",
            "status": "activa",
            "emailHint": "h***@example.test"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/superadmin/memberships/:membershipId
    method: PATCH
    mode: json
    params:path: {
      membershipId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "status": "",
        "reason": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

