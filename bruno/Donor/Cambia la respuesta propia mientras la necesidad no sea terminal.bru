meta {
  name: Cambia la respuesta propia mientras la necesidad no sea terminal
  type: http
  seq: 11
  tags: [
    Donor
  ]
}

patch {
  url: {{baseUrl}}/api/v1/donors/me/invitations/:invitationId/response
  body: json
  auth: inherit
}

params:path {
  invitationId: 76eb9a7c-484f-4478-9a6f-01a21710ce8f
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "response": "rechazada"
  }
}

docs {
  Solo cambia la respuesta del donante autenticado. Conserva historial y no crea un nuevo lote; el hospital pierde los campos identificables cuando el estado vigente pasa a rechazada.
}

example {
  name: 200 Response
  description: Respuesta actualizada.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/invitations/:invitationId/response
    method: PATCH
    mode: json
    params:path: {
      invitationId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "response": "rechazada"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "response": "confirmada",
            "recordedAt": "2026-10-01T18:20:00Z",
            "needStatus": "activa"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/invitations/:invitationId/response
    method: PATCH
    mode: json
    params:path: {
      invitationId:
    }

    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "response": "rechazada"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

