meta {
  name: Consulta historial inmutable de respuestas propias
  type: http
  seq: 12
  tags: [
    Donor
  ]
}

get {
  url: {{baseUrl}}/api/v1/donors/me/responses
  body: none
  auth: inherit
}

params:query {
  @description('Límite por página propuesto; el máximo debe aplicarse también en servidor.')
  limit: 20
  @description('Cursor opaco devuelto por la página anterior; no contiene PII.')
  ~cursor:
}

example {
  name: 200 Response
  description: Historial del propietario autenticado.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "items": [
              {
                "invitationId": "76eb9a7c-484f-4478-9a6f-01a21710ce8f",
                "response": "confirmada",
                "changedAt": "2026-10-01T18:20:00Z"
              }
            ],
            "pagination": {
              "nextCursor": null
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/responses
    method: GET
    mode: none
    params:query: {
      limit: 20
      ~cursor:
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
