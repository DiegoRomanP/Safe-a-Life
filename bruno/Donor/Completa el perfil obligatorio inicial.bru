meta {
  name: Completa el perfil obligatorio inicial
  type: http
  seq: 6
  tags: [
    Donor
  ]
}

put {
  url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "name": "Donante Demo",
    "declaredBloodType": "O_POS",
    "isAvailable": true,
    "approximateLocation": {
      "latitude": -12.046,
      "longitude": -77.043
    }
  }
}

docs {
  Solo disponible para cuenta verificada/incompleta. En perfiles activos, nombre y grupo se cambian mediante solicitud; no aceptar historial de donación.
}

example {
  name: 200 Response
  description: Perfil completo y cuenta activa.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "name": "",
        "declaredBloodType": "O_NEG",
        "isAvailable": false,
        "approximateLocation": {
          "latitude": 0,
          "longitude": 0
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "name": "Donante Demo",
            "email": "donante.demo@example.test",
            "declaredBloodType": "O_POS",
            "isAvailable": true,
            "approximateLocation": {
              "latitude": -12.046,
              "longitude": -77.043
            }
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "name": "",
        "declaredBloodType": "O_NEG",
        "isAvailable": false,
        "approximateLocation": {
          "latitude": 0,
          "longitude": 0
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "name": "",
        "declaredBloodType": "O_NEG",
        "isAvailable": false,
        "approximateLocation": {
          "latitude": 0,
          "longitude": 0
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "STATE_CONFLICT",
            "message": "La operación entra en conflicto con el estado actual.",
            "correlationId": "00000000-0000-4000-8000-000000000409"
          }
        }
      '''
    }
  }
}

example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/onboarding-profile
    method: PUT
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "name": "",
        "declaredBloodType": "O_NEG",
        "isAvailable": false,
        "approximateLocation": {
          "latitude": 0,
          "longitude": 0
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Uno o más valores no cumplen las reglas del campo.",
            "correlationId": "00000000-0000-4000-8000-000000000422"
          }
        }
      '''
    }
  }
}
