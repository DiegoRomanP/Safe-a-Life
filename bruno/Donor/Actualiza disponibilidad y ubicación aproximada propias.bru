    }

    body:json: {
      {
        "isAvailable": true,
        "approximateLocation": {
          "latitude": -12.046,
          "longitude": -77.043
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "BAD_REQUEST",
            "message": "Solicitud malformada.",
            "correlationId": "00000000-0000-4000-8000-000000000400"
          }
        }
      '''
    }
  }
}

