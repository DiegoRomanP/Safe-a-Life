meta {
  name: Actualiza disponibilidad y ubicación aproximada propias
  type: http
  seq: 8
  tags: [
    Donor
  ]
}

patch {
  url: {{baseUrl}}/api/v1/donors/me/profile
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
  Origin: {{appOrigin}}
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "isAvailable": true,
    "approximateLocation": {
      "latitude": -12.046,
      "longitude": -77.043
    }
  }
}

docs {
  Únicamente admite disponibilidad y ubicación sintética aproximada dentro del polígono versionado de Lima, con hasta tres decimales. Nombre, email y grupo declarado siguen un flujo de solicitud. No aceptar fecha ni historial de donación (RF-PRO-01, RF-PRO-05).
}

example {
  name: 200 Response
  description: Perfil propio actualizado.

  request: {
    url: {{baseUrl}}/api/v1/donors/me/profile
    method: PATCH
    mode: json
    headers: {
      Idempotency-Key:
      session: {{apiKey}}
    }

    body:json: {
      {
        "isAvailable": true,
        "approximateLocation": {
          "latitude": -12.046,
          "longitude": -77.043
        }
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "name": "Donante Demo",
            "email": "donante.demo@example.test",
            "declaredBloodType": "O_POS",
            "isAvailable": true,
            "approximateLocation": {
              "latitude": -12.046,
              "longitude": -77.043
            }
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
