meta {
  name: Completa recuperación con token de un solo uso
  type: http
  seq: 6
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset-actions/:token
  body: json
  auth: inherit
}

params:path {
  @description('Credencial de un solo uso; nunca registrar token ni URL.')
  token:
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "newPassword": "synthetic-password-placeholder"
  }
}

example {
  name: 200 Response
  description: Contraseña cambiada; sesiones anteriores revocadas.

  request: {
    url: {{baseUrl}}/api/v1/auth/password-reset-actions/:token
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "message": "Si la solicitud puede procesarse, recibirás instrucciones."
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Recurso inexistente o no visible para este actor.

  request: {
    url: {{baseUrl}}/api/v1/auth/password-reset-actions/:token
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RESOURCE_NOT_FOUND",
            "message": "El recurso no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000404"
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Conflicto de estado, concurrencia o idempotencia.

  request: {
    url: {{baseUrl}}/api/v1/auth/password-reset-actions/:token
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "STATE_CONFLICT",
            "message": "La operación entra en conflicto con el estado actual.",
            "correlationId": "00000000-0000-4000-8000-000000000409"
          }
        }
      '''
    }
  }
}

example {
  name: 410 Response
  description: Token de acción vencido o consumido.

  request: {
    url: {{baseUrl}}/api/v1/auth/password-reset-actions/:token
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 410
      text: Gone
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "ACTION_UNAVAILABLE",
            "message": "El enlace no está disponible.",
            "correlationId": "00000000-0000-4000-8000-000000000410"
          }
        }
      '''
    }
  }
}

