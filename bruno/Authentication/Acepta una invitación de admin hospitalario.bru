example {
  name: 422 Response
  description: Solicitud bien formada pero semánticamente inválida.

  request: {
    url: {{baseUrl}}/api/v1/hospital-admin-invitation-actions/:token/claim
    method: POST
    mode: json
    params:path: {
      token:
    }

