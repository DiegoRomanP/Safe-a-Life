meta {
  name: Acepta una invitación de admin hospitalario
  type: http
  seq: 10
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/hospital-admin-invitation-actions/:token/claim
  body: json
  auth: inherit
}

params:path {
  @description('Secreto de acción de un solo uso, ligado a invitación y acción. Nunca incluir valores reales en documentación, logs o ejemplos.')
  token:
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "password": "synthetic-password-placeholder"
  }
}

docs {
  Hospital/rol vienen de la invitación protegida. La nueva cuenta administrativa requiere MFA/AAL2 antes de operar.
}

example {
  name: 201 Response
  description: Invitación reclamada; sesión administrativa queda pendiente de MFA.

  request: {
    url: {{baseUrl}}/api/v1/hospital-admin-invitation-actions/:token/claim
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "actor": {
              "role": "admin_hospitalario",
              "displayName": "Admin Demo",
              "hospitalName": "Hospital Demo"
            },
            "aal": 1,
            "mfaRequired": true,
            "mfaChallengeId": "cb6ad07d-04d3-4e94-9534-4c0b4d1530f8"
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Solicitud malformada.

  request: {
    url: {{baseUrl}}/api/v1/hospital-admin-invitation-actions/:token/claim
    method: POST
    mode: json
    params:path: {
      token:
    }

    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "BAD_REQUEST",
            "message": "Solicitud malformada.",
            "correlationId": "00000000-0000-4000-8000-000000000400"
          }
        }
      '''
    }
  }
}

