meta {
  name: Inicia sesión mediante Express y Supabase Auth
  type: http
  seq: 3
  tags: [
    Authentication
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: json
  auth: inherit
}

headers {
  @description('Clave estable para reintentos de la misma intención. El servidor la liga a actor, operación y hash canónico del payload; no registrar su valor.')
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "email": "donante.demo@example.test",
    "password": "synthetic-demo-only"
  }
}

docs {
  La respuesta no enumera cuentas; administradores deben completar MFA/AAL2 antes de operaciones administrativas.
}

example {
  name: 200 Response
  description: Sesión creada o reto MFA requerido; la cookie de sesión es Secure/HttpOnly.

  request: {
    url: {{baseUrl}}/api/v1/auth/sessions
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "email": "donante.demo@example.test",
        "password": "synthetic-demo-only"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "actor": {
              "role": "donante",
              "displayName": "Donante Demo"
            },
            "aal": 1,
            "mfaRequired": false
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Solicitud malformada.

  request: {
    url: {{baseUrl}}/api/v1/auth/sessions
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "email": "donante.demo@example.test",
        "password": "synthetic-demo-only"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "BAD_REQUEST",
            "message": "Solicitud malformada.",
            "correlationId": "00000000-0000-4000-8000-000000000400"
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Autenticación ausente, inválida o vencida.

  request: {
    url: {{baseUrl}}/api/v1/auth/sessions
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "email": "donante.demo@example.test",
        "password": "synthetic-demo-only"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "AUTHENTICATION_REQUIRED",
            "message": "La sesión no está vigente.",
            "correlationId": "00000000-0000-4000-8000-000000000401"
          }
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Límite de intentos o abuso alcanzado.

  request: {
    url: {{baseUrl}}/api/v1/auth/sessions
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "email": "donante.demo@example.test",
        "password": "synthetic-demo-only"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "RATE_LIMITED",
            "message": "Intenta nuevamente más tarde.",
            "correlationId": "00000000-0000-4000-8000-000000000429"
          }
        }
      '''
    }
  }
}

example {
  name: 500 Response
  description: Error interno sin detalles de implementación.

  request: {
    url: {{baseUrl}}/api/v1/auth/sessions
    method: POST
    mode: json
    headers: {
      Idempotency-Key:
    }

    body:json: {
      {
        "email": "donante.demo@example.test",
        "password": "synthetic-demo-only"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "code": "INTERNAL_ERROR",
            "message": "No se pudo completar la solicitud.",
            "correlationId": "00000000-0000-4000-8000-000000000500"
          }
        }
      '''
    }
  }
}
